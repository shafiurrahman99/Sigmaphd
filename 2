                <p class="text-emerald-400 font-bold text-[11px] uppercase tracking-wider">Customer Details (Open)</p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    <input type="text" id="memoCustomerName" placeholder="Customer Name" value="Customer X" required class="bg-[#131822] border border-slate-700 rounded-xl py-2 px-3 text-slate-200">
                    <input type="text" id="memoCustomerMobile" placeholder="Customer Mobile" value="01800000000" required class="bg-[#131822] border border-slate-700 rounded-xl py-2 px-3 text-slate-200">
                </div>
            </div>

            <div class="bg-[#080a0f] border border-slate-800 rounded-2xl p-3 space-y-2 text-xs">
                <p class="text-indigo-400 font-bold text-[11px] uppercase tracking-wider">Add Product (Open)</p>
                <div class="grid grid-cols-12 gap-1.5">
                    <input type="text" id="memoProdDesc" placeholder="Description" value="Software License Key" class="col-span-6 bg-[#131822] border border-slate-700 rounded-xl py-2 px-2.5 text-slate-200">
                    <input type="number" id="memoProdQty" placeholder="Qty" min="1" value="1" class="col-span-2 bg-[#131822] border border-slate-700 rounded-xl py-2 px-2 text-center text-slate-200">
                    <input type="number" id="memoProdRate" placeholder="Rate" min="0" value="500" class="col-span-4 bg-[#131822] border border-slate-700 rounded-xl py-2 px-2.5 text-emerald-400">
                </div>
                <button type="button" onclick="addProductToMemoCart()" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-2 rounded-xl text-xs">Add Item to Cart</button>

                <div class="overflow-x-auto border border-slate-800 rounded-xl mt-2">
                    <table class="w-full text-left text-[11px]">
                        <thead class="bg-[#131822] text-slate-400 border-b border-slate-800">
                            <tr>
                                <th class="py-1.5 px-2">Item</th>
                                <th class="py-1.5 px-1 text-center">Qty</th>
                                <th class="py-1.5 px-1 text-right">Rate</th>
                                <th class="py-1.5 px-2 text-right">Total</th>
                                <th class="py-1.5 px-1 text-center">×</th>
                            </tr>
                        </thead>
                        <tbody id="memoCartTableBody" class="divide-y divide-slate-800/60"></tbody>
                    </table>
                </div>
                <div class="flex justify-between items-center pt-1 font-extrabold text-sm">
                    <span class="text-slate-300">Grand Total:</span>
                    <span id="memoCartGrandTotal" class="text-emerald-400 font-mono">৳ 500.00</span>
                </div>
            </div>

            <button type="button" onclick="openA4PdfPreview()" class="w-full bg-gradient-to-r from-emerald-600 to-teal-600 text-white font-extrabold py-3 rounded-xl text-xs shadow-lg flex items-center justify-center space-x-1.5">
                <i class="fa-solid fa-file-pdf"></i><span>PDF Preview (A4 Size)</span>
            </button>
        </div>
    </div>

    <!-- A4 PDF Preview Modal -->
    <div id="a4PdfPreviewModal" class="hidden fixed inset-0 z-[110] bg-black/90 backdrop-blur-md flex flex-col items-center justify-center p-2 sm:p-4 overflow-y-auto">
        <div class="bg-white text-black w-full max-w-2xl rounded-2xl p-6 shadow-2xl relative space-y-4 my-auto">
            <button onclick="document.getElementById('a4PdfPreviewModal').classList.add('hidden')" class="absolute top-4 right-4 text-slate-700 hover:text-black text-xl"><i class="fa-solid fa-xmark"></i></button>
            <div id="a4PdfContentBox" class="border border-slate-300 p-6 rounded-xl bg-white shadow-inner space-y-4 text-sm font-sans"></div>
            <div class="flex items-center justify-end space-x-3 pt-3 border-t border-slate-200">
                <button type="button" onclick="saveMemoToDevice()" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2.5 px-5 rounded-xl text-xs flex items-center space-x-1.5 shadow">
                    <i class="fa-solid fa-download"></i><span>Save in Device</span>
                </button>
                <button type="button" onclick="printMemoPdf()" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-2.5 px-5 rounded-xl text-xs flex items-center space-x-1.5 shadow">
                    <i class="fa-solid fa-print"></i><span>Print</span>
                </button>
            </div>
        </div>
    </div>

    <!-- User & Password Change Modal -->
    <div id="userPassModal" class="modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.75); z-index: 9999; justify-content: center; align-items: center;">
        <div style="background: #1e293b; border: 1px solid #334155; border-radius: 12px; width: 90%; max-width: 420px; padding: 24px; color: #f8fafc; box-shadow: 0 10px 25px rgba(0,0,0,0.5);">
            
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; border-bottom: 1px solid #334155; padding-bottom: 10px;">
                <h3 style="margin: 0; font-size: 18px; color: #38bdf8;">user_password_change</h3>
                <span onclick="closeUserPassModal()" style="cursor: pointer; font-size: 20px; color: #94a3b8;">&times;</span>
            </div>

            <!-- ডাটাবেজ ফিল্ড অনুযায়ী কম্পোজিট আইডি ও বায়ার ইমেইল প্রদর্শন বক্স -->
            <div style="background: #0f172a; padding: 10px 12px; border-radius: 8px; margin-bottom: 15px; font-size: 13px;">
                <div style="display: flex; justify-content: space-between; margin-bottom: 6px;">
                    <span style="color: #94a3b8;">composite_user_id:</span>
                    <span id="modalCompositeId" style="color: #34d399; font-weight: bold;">--</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="color: #94a3b8;">buyer_email:</span>
                    <span id="modalAutoEmail" style="color: #fbbf24; font-weight: 500;">--</span>
                </div>
                <div style="font-size: 11px; color: #64748b; margin-top: 6px; text-align: right;">
                    * পরিবর্তনের কনফার্মেশন নোটিফিকেশন এই ইমেইলে পাঠানো হবে।
                </div>
            </div>

            <!-- ইনপুট ফর্ম -->
            <div style="display: flex; flex-direction: column; gap: 12px;">
                <div>
                    <label style="font-size: 12px; color: #cbd5e1; display: block; margin-bottom: 4px;">নতুন ইউজারনেম (New Username)</label>
                    <input type="text" id="newUsernameInput" placeholder="নতুন ইউজারনেম লিখুন" style="width: 100%; padding: 9px 12px; border-radius: 6px; border: 1px solid #475569; background: #0f172a; color: white; box-sizing: border-box;">
                </div>

                <div>
                    <label style="font-size: 12px; color: #cbd5e1; display: block; margin-bottom: 4px;">পুরাতন পাসওয়ার্ড (Old Password) *</label>
                    <input type="password" id="oldPasswordInput" placeholder="বর্তমান পাসওয়ার্ড দিন" required style="width: 100%; padding: 9px 12px; border-radius: 6px; border: 1px solid #475569; background: #0f172a; color: white; box-sizing: border-box;">
                </div>

                <div>
                    <label style="font-size: 12px; color: #cbd5e1; display: block; margin-bottom: 4px;">নতুন পাসওয়ার্ড (New Password) *</label>
                    <input type="password" id="newPasswordInput" placeholder="নতুন পাসওয়ার্ড দিন" required style="width: 100%; padding: 9px 12px; border-radius: 6px; border: 1px solid #475569; background: #0f172a; color: white; box-sizing: border-box;">
                </div>

                <div>
                    <label style="font-size: 12px; color: #cbd5e1; display: block; margin-bottom: 4px;">পুনরায় নতুন পাসওয়ার্ড (Confirm New Password) *</label>
                    <input type="password" id="confirmPasswordInput" placeholder="নতুন পাসওয়ার্ডটি আবার লিখুন" required style="width: 100%; padding: 9px 12px; border-radius: 6px; border: 1px solid #475569; background: #0f172a; color: white; box-sizing: border-box;">
                </div>
            </div>

            <!-- Accept & Login Again বাটন -->
            <button id="btnAcceptLoginAgain" onclick="submitUserPasswordChange()" style="width: 100%; margin-top: 20px; padding: 11px; background: #10b981; color: white; font-weight: bold; border: none; border-radius: 8px; cursor: pointer; font-size: 14px;">
                Accept & Login Again
            </button>

        </div>
    </div>

    <!-- Hidden A4 Print Area -->
    <div id="a4MemoPrintArea" class="hidden"></div>
    
    <!-- External Script Integration -->
    <script src="script.js"></script>
</body>
</html>
 