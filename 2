<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Develop App - Dashboard</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        bgMain: '#07090d',
                        cardBg: '#131822',
                        innerDark: '#080a0f',
                        accentGreen: '#0fa968',
                        accentOrange: '#f59e0b',
                    },
                    fontFamily: {
                        sans: ['Inter', 'Hind Siliguri', 'sans-serif'],
                        bengali: ['Hind Siliguri', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Inter', 'Hind Siliguri', sans-serif;
            background-color: #07090d;
            color: #e2e8f0;
            user-select: none;
        }
        .gradient-text {
            background: linear-gradient(135deg, #f59e0b 0%, #ef4444 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .buy-btn-gradient {
            background: linear-gradient(90deg, #f59e0b 0%, #f43f5e 50%, #ec4899 100%);
            transition: all 0.3s ease;
        }
        .buy-btn-gradient:hover {
            opacity: 0.95;
            transform: translateY(-1px);
        }
        ::-webkit-scrollbar { width: 5px; }
        ::-webkit-scrollbar-track { background: #0d1117; }
        ::-webkit-scrollbar-thumb { background: #1f293d; border-radius: 10px; }
        @media print {
            body * { visibility: hidden; }
            #a4MemoPrintArea, #a4MemoPrintArea * { visibility: visible; }
            #a4MemoPrintArea {
                position: fixed; left: 0; top: 0; width: 210mm; min-height: 297mm;
                margin: 0; padding: 15mm; background: white !important; color: black !important; box-shadow: none !important; z-index: 9999;
            }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-start p-2 sm:p-4 bg-slate-950">

    <!-- Toast Notification -->
    <div id="toast" class="hidden fixed top-4 left-1/2 -translate-x-1/2 z-[120] w-11/12 max-w-md bg-emerald-600 text-white px-4 py-3 rounded-xl shadow-2xl flex items-center justify-between text-sm font-medium transition-all duration-300">
        <span id="toast-text">Action successful!</span>
        <button onclick="hideToast()" class="text-white hover:text-emerald-200 ml-2">
            <i class="fa-solid fa-xmark text-base"></i>
        </button>
    </div>

    <!-- ================= PAGE 1: LOGIN & LANDING ================= -->
    <div id="page1" class="w-full max-w-md mx-auto space-y-4 my-auto py-4">
        <div class="bg-[#131822] rounded-3xl p-5 sm:p-6 shadow-2xl border border-slate-800/80 relative overflow-hidden">
            <div class="flex items-start justify-between mb-5">
                <div>
                    <h1 class="text-2xl font-extrabold text-white tracking-tight">My Develop App</h1>
                    <p class="font-bengali text-emerald-400 font-semibold text-sm mt-0.5 tracking-wide">নিজের হাতে গড়া</p>
                </div>
                <div class="text-right">
                    <span class="gradient-text font-black text-lg italic tracking-wider block">Sigma PhD™</span>
                </div>
            </div>

            <!-- Sign In Form (user_name & password) -->
            <form onsubmit="handleMainSignIn(event)" class="space-y-4">
                <div>
                    <input type="text" id="mainUserName" required placeholder="Enter Username (e.g., admin)" value="admin"
                        class="w-full bg-[#080a0f] border border-slate-700/60 rounded-2xl py-3 px-4 text-emerald-400 font-medium tracking-wide focus:outline-none focus:border-emerald-500 transition-all text-sm">
                </div>
                <div>
                    <input type="password" id="mainUserPassword" required placeholder="Enter Password (e.g., 1234)" value="1234"
                        class="w-full bg-[#080a0f] border border-slate-700/60 rounded-2xl py-3 px-4 text-emerald-400 font-medium tracking-widest focus:outline-none focus:border-emerald-500 transition-all text-sm">
                </div>

                <button type="submit" 
                    class="w-full bg-[#0fa968] hover:bg-[#0c8e57] text-slate-950 font-bold py-3.5 px-4 rounded-2xl flex items-center justify-center space-x-2 transition-all active:scale-95 shadow-lg shadow-emerald-900/20 text-base mt-2">
                    <span>Sign In</span>
                    <i class="fa-solid fa-arrow-right text-sm"></i>
                </button>
            </form>

            <div class="my-4 border-t border-slate-800"></div>

            <button type="button" onclick="openBuyLicenseLandingModal()" 
                class="w-full buy-btn-gradient text-slate-950 font-extrabold py-3.5 px-4 rounded-2xl flex items-center justify-center space-x-2 shadow-lg active:scale-95 text-base">
                <i class="fa-solid fa-credit-card text-base text-slate-900"></i>
                <span>Buy New ID</span>
            </button>
        </div>
    </div>

    <!-- ================= PAGE 2: DASHBOARD ================= -->
    <div id="page2" class="hidden w-full max-w-md mx-auto space-y-4 py-2">
        <!-- Accounts Toggle Button Bar -->
        <div class="bg-[#131822] border border-slate-800/80 rounded-2xl p-2.5 shadow-xl flex items-center justify-between">
            <span class="text-xs font-bold text-slate-200 flex items-center space-x-2">
                <i class="fa-solid fa-user-gear text-emerald-400"></i>
                <span>User Account & Devices</span>
            </span>
            <button type="button" onclick="toggleAccountsSection()" class="bg-emerald-600 hover:bg-emerald-500 text-slate-950 font-bold px-3 py-1.5 rounded-xl text-xs flex items-center space-x-1.5 transition-all shadow">
                <i class="fa-solid fa-chevron-down" id="accountsToggleIcon"></i>
                <span id="accountsToggleText">Show Accounts</span>
            </button>
        </div>

        <!-- Collapsible Accounts & Devices Section -->
        <div id="accountsSectionContainer" class="hidden space-y-4">
            <div class="bg-[#131822] border border-slate-800/80 rounded-2xl p-4 flex items-center justify-between shadow-xl">
                <div class="flex items-center space-x-3">
                    <div class="relative cursor-pointer" onclick="openAddDeviceModal()" title="Add New Device">
                        <div class="w-10 h-10 bg-emerald-950/80 border border-emerald-500/40 rounded-xl flex items-center justify-center text-emerald-400 text-lg">
                            <i class="fa-solid fa-mobile-screen-button"></i>
                        </div>
                        <span class="absolute -top-1.5 -right-1.5 bg-emerald-500 text-slate-950 font-black w-5 h-5 rounded-full flex items-center justify-center text-xs shadow-md">+</span>
                    </div>
                    <div>
                        <h2 class="text-xs font-bold text-white flex items-center space-x-1">
                            <span id="activeDeviceCount">1</span> Device Active 
                            <span class="text-slate-400 font-normal">(Max 2)</span>
                        </h2>
                        <span class="text-[10px] text-amber-400 font-mono">Composite ID: <strong id="displayCompositeId">101_admin</strong></span>
                    </div>
                </div>

                <div class="flex items-center space-x-1.5">
                    <div class="text-right">
                        <span class="text-[10px] text-slate-400 block font-medium">Balance</span>
                        <span id="walletBalanceText" class="text-emerald-400 font-extrabold text-xs font-mono">৳ 0.00</span>
                    </div>
                    <button onclick="openBalanceTransferModal()" class="w-7 h-7 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-lg flex items-center justify-center text-xs shadow transition-all" title="Balance Transfer to User">
                        <i class="fa-solid fa-right-left"></i>
                    </button>
                </div>
            </div>

            <!-- Top Profile Bar with Live Countdown Clock & Validity Plus Button -->
            <div class="bg-[#131822] border border-slate-800/80 rounded-2xl p-3.5 shadow-xl space-y-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-2.5">
                        <div class="w-9 h-9 bg-emerald-500/10 border border-emerald-500/30 rounded-full flex items-center justify-center text-emerald-400 font-bold">
                            <i class="fa-solid fa-user-check text-sm"></i>
                        </div>
                        <div>
                            <h3 class="text-xs font-bold text-white">User: <strong id="currentLoggedInUser" class="text-emerald-400">admin</strong></h3>
                            <p class="text-[10px] text-slate-400 font-medium mt-0.5" id="validityStatusText">Validity Countdown</p>
                        </div>
                    </div>

                    <div class="flex items-center space-x-2">
                        <button onclick="openUserPassModal()" class="bg-blue-600 hover:bg-blue-500 text-white border-none py-1.5 px-3 rounded-lg text-xs font-semibold cursor-pointer shadow">
                            ⚙️ Password Change
                        </button>

                        <button type="button" onclick="handleLogOut()" class="bg-rose-600/20 hover:bg-rose-600/30 border border-rose-500/40 text-rose-400 font-bold py-1.5 px-2.5 rounded-xl text-xs flex items-center space-x-1 transition-all">
                            <i class="fa-solid fa-arrow-right-from-bracket text-xs"></i>
                            <span>Log Out</span>
                        </button>
                    </div>
                </div>

                <!-- Validity Countdown Clock Display with Plus Button -->
                <div class="bg-[#080a0f] border border-amber-500/30 rounded-xl p-2.5 flex items-center justify-around text-center relative">
                    <div>
                        <span id="countdownDays" class="text-amber-400 font-extrabold text-base block font-mono">00</span>
                        <span class="text-[9px] text-slate-400 uppercase tracking-wider font-bold">Days</span>
                    </div>
                    <span class="text-slate-600 font-bold text-sm">:</span>
                    <div>
                        <span id="countdownHours" class="text-amber-400 font-extrabold text-base block font-mono">00</span>
                        <span class="text-[9px] text-slate-400 uppercase tracking-wider font-bold">Hours</span>
                    </div>
                    <span class="text-slate-600 font-bold text-sm">:</span>
                    <div>
                        <span id="countdownMins" class="text-amber-400 font-extrabold text-base block font-mono">00</span>
                        <span class="text-[9px] text-slate-400 uppercase tracking-wider font-bold">Mins</span>
                    </div>
                    <span class="text-slate-600 font-bold text-sm">:</span>
                    <div>
                        <span id="countdownSecs" class="text-emerald-400 font-extrabold text-base block font-mono animate-pulse">00</span>
                        <span class="text-[9px] text-slate-400 uppercase tracking-wider font-bold">Secs</span>
                    </div>
                    <button type="button" onclick="openBuyValidityModal()" class="absolute -top-2.5 -right-2.5 bg-emerald-600 hover:bg-emerald-500 text-slate-950 font-black w-7 h-7 rounded-full flex items-center justify-center text-xs shadow-lg transition-all" title="Extend Validity">
                        <i class="fa-solid fa-plus"></i>
                    </button>
                </div>

                <!-- Admin Approval Pending Badge near Validity Countdown -->
                <div id="validityPendingBadge" class="hidden inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-950 text-amber-400 border border-amber-600/50"></div>
            </div>

            <!-- Referral / Coupon Card -->
            <div class="bg-[#131822] border border-slate-800/80 rounded-2xl p-3.5 shadow-xl space-y-2.5">
                <div class="flex items-center justify-between text-xs">
                    <span class="text-slate-300 font-bold flex items-center space-x-1.5">
                        <i class="fa-solid fa-link text-emerald-400"></i>
                        <span>Referral Chain & User Sale</span>
                    </span>
                    <span class="bg-indigo-900/40 text-indigo-300 border border-indigo-700/50 px-2 py-0.5 rounded-md text-[10px] font-semibold">
                        Sub-Users: <strong class="text-emerald-400 font-extrabold text-xs" id="subUserCount">1</strong> active
                    </span>
                </div>
                
                <div class="flex items-center justify-between bg-[#080a0f] border border-slate-700/80 rounded-xl p-2.5">
                    <div class="flex items-center space-x-2">
                        <span class="text-slate-400 text-xs">Coupon Code:</span>
                        <span id="userCouponCode" class="text-amber-400 font-extrabold tracking-widest text-sm bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/30">SIGMA-ADMIN</span>
                    </div>
                    <button onclick="copyCouponCode()" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold py-1.5 px-3 rounded-lg flex items-center space-x-1 transition-all">
                        <i class="fa-regular fa-copy"></i>
                        <span>Copy</span>
                    </button>
                </div>

                <div class="grid grid-cols-2 gap-2">
                    <button onclick="openBuyLotModal()" class="bg-amber-600 hover:bg-amber-500 text-slate-950 font-bold py-2.5 px-2 rounded-xl text-xs flex items-center justify-center space-x-1 shadow-lg transition-all">
                        <i class="fa-solid fa-boxes-packing text-xs"></i>
                        <span>Buy New Lot</span>
                    </button>
                    <button onclick="openSellLicenseModal()" class="bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 text-white font-bold py-2.5 px-2 rounded-xl text-xs flex items-center justify-center space-x-1 shadow-lg transition-all">
                        <i class="fa-solid fa-paper-plane text-xs"></i>
                        <span>Sell New ID</span>
                    </button>
                </div>

                <div class="bg-[#080a0f] border border-slate-800 rounded-xl p-2.5 space-y-2">
                    <div class="flex items-center justify-between text-[11px]">
                        <span class="text-slate-300 font-bold flex items-center space-x-1">
                            <i class="fa-solid fa-layer-group text-amber-400"></i>
                            <span>My Purchased Lots (In_Stock):</span>
                        </span>
                        <span class="text-emerald-400 font-extrabold">Available IDs: <span id="availableLotIdsCount">1</span></span>
                    </div>
                    <div id="lotInventorySummaryList" class="space-y-1.5 max-h-28 overflow-y-auto text-[11px]"></div>
                </div>
            </div>
        </div>

        <!-- Navigation Tabs Bar -->
        <div class="bg-[#131822] border border-slate-800/80 rounded-2xl p-2 shadow-xl">
            <div class="grid grid-cols-3 gap-1 text-xs">
                <button class="bg-emerald-600 text-white font-bold py-2 rounded-xl text-center shadow-md">Dashboard</button>
                <button onclick="openMyChatModal()" class="bg-[#1a2130] hover:bg-slate-800 text-slate-300 font-medium py-2 rounded-xl text-center border border-slate-700/50">My Chat</button>
                <button onclick="openCashMemoModal()" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-2 rounded-xl text-center shadow-md flex items-center justify-center space-x-1">
                    <i class="fa-solid fa-receipt"></i>
                    <span>Cash Memo</span>
                </button>
            </div>
        </div>

        <!-- Monthly Financial Summary Card -->
        <div class="bg-[#131822] border border-slate-800/80 rounded-2xl p-4 shadow-xl space-y-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-chart-line text-emerald-400 text-base"></i>
                    <h3 class="text-xs sm:text-sm font-bold text-white">Monthly Summary (Income, Expense, Surplus)</h3>
                </div>
                <button onclick="openIncomeModal()" class="bg-emerald-600 hover:bg-emerald-500 text-slate-950 font-bold px-3 py-1.5 rounded-xl text-xs flex items-center space-x-1 shadow transition-all shrink-0">
                    <span>+</span>
                    <span>New Income/Expense</span>
                </button>
            </div>

            <div class="overflow-x-auto border border-slate-800/80 rounded-xl">
                <table class="w-full text-left text-xs">
                    <thead class="bg-[#080a0f] text-slate-400 border-b border-slate-800">
                        <tr>
                            <th class="py-2.5 px-3">2026</th>
                            <th class="py-2.5 px-2">Total Income (৳)</th>
                            <th class="py-2.5 px-2">Total Expense (৳)</th>
                            <th class="py-2.5 px-2 text-right">Net Surplus (৳)</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/60 font-medium">
                        <tr class="bg-emerald-950/20 text-emerald-400 font-bold">
                            <td class="py-3 px-3">Total All-Time</td>
                            <td id="totalIncomeAll" class="py-3 px-2">৳ 0.00</td>
                            <td id="totalExpenseAll" class="py-3 px-2 text-rose-400">৳ 0.00</td>
                            <td id="totalSurplusAll" class="py-3 px-2 text-right">৳ 0.00</td>
                        </tr>
                    </tbody>
                    <tbody id="monthlyRowsContainer" class="divide-y divide-slate-800/40"></tbody>
                </table>
            </div>
        </div>

        <!-- Loan Management Card -->
        <div class="bg-[#131822] border border-slate-800/80 rounded-2xl p-4 shadow-xl space-y-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-hand-holding-dollar text-amber-400 text-base"></i>
                    <h3 class="text-xs sm:text-sm font-bold text-white">Loan & Credit Records</h3>
                </div>
                <button onclick="openLoanModal()" class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-3 py-1.5 rounded-xl text-xs flex items-center space-x-1 shadow transition-all shrink-0">
                    <span>+</span>
                    <span>New Entry</span>
                </button>
            </div>

            <div class="bg-[#080a0f] border border-slate-800 rounded-xl p-3 space-y-2">
                <div class="flex items-center justify-between text-xs border-b border-slate-800 pb-2">
                    <span class="text-amber-400 font-bold">Receivable</span>
                    <span id="loanGivenTotalText" class="text-emerald-400 font-extrabold">Total: ৳ 0.00</span>
                </div>
                <div id="loanGivenList" class="space-y-2"></div>
            </div>

            <div class="bg-[#080a0f] border border-slate-800 rounded-xl p-3 space-y-2">
                <div class="flex items-center justify-between text-xs border-b border-slate-800 pb-2">
                    <span class="text-rose-400 font-bold">Payable</span>
                    <span id="loanTakenTotalText" class="text-rose-400 font-extrabold">Total: ৳ 0.00</span>
                </div>
                <div id="loanTakenList" class="space-y-2"></div>
            </div>
        </div>

        <!-- Daily Expenses Card -->
        <div class="bg-[#131822] border border-slate-800/80 rounded-2xl p-4 shadow-xl space-y-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-cart-shopping text-indigo-400 text-base"></i>
                    <h3 class="text-xs sm:text-sm font-bold text-white">Daily Expenses Log (Auto Expense Sync)</h3>
                </div>
                <button onclick="openMarketModal()" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-3 py-1.5 rounded-xl text-xs flex items-center space-x-1 shadow transition-all shrink-0">
                    <span>+</span>
                    <span>New Expense Entry</span>
                </button>
            </div>

            <div class="overflow-x-auto border border-slate-800/80 rounded-xl">
                <table class="w-full text-left text-xs">
                    <thead class="bg-[#080a0f] text-slate-400 border-b border-slate-800">
                        <tr>
                            <th class="py-2.5 px-2">Date</th>
                            <th class="py-2.5 px-2">Description</th>
                            <th class="py-2.5 px-2">Amount (৳)</th>
                            <th class="py-2.5 px-2 text-right">Status & Action</th>
                        </tr>
                    </thead>
                    <tbody id="marketExpenseList" class="divide-y divide-slate-800/50 font-medium"></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ================= MODALS ================= -->
    <!-- Buy Validity Modal (Dropdown + Cart + Backend Calculation + Cash Pay) -->
    <div id="buyValidityModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-[#131822] border border-slate-700 w-full max-w-md rounded-3xl p-5 shadow-2xl relative space-y-3.5 text-xs">
            <div class="flex items-center justify-between border-b border-slate-800 pb-2.5">
                <h3 class="text-base font-bold text-white">Extend Validity</h3>
                <button type="button" onclick="closeBuyValidityModal()" class="text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
            </div>

            <!-- Pending Approval Notice inside Modal -->
            <div id="validityModalPendingNotice" class="hidden bg-amber-950/60 border border-amber-500/50 rounded-2xl p-3 text-xs text-amber-300 space-y-1">
                <div class="font-extrabold text-amber-400">Wait for Validity Approval</div>
                <div id="validityModalPendingDetails" class="text-[11px] text-amber-200/90 font-mono"></div>
            </div>

            <!-- Plan Dropdown + Add Button -->
            <div class="flex gap-2">
                <select id="validityPlanDropdown" class="flex-1 bg-[#080a0f] border border-slate-700 rounded-xl py-2 px-3 text-white focus:outline-none focus:border-emerald-500">
                    <option value="1">1 Month (30 Days)</option>
                    <option value="2">2 Months (60 Days)</option>
                    <option value="3">3 Months (90 Days)</option>
                    <option value="6">6 Months (180 Days)</option>
                </select>
                <button type="button" onclick="addValidityToCart()" class="bg-emerald-600 hover:bg-emerald-500 text-slate-950 font-bold px-4 py-2 rounded-xl transition">+ Add</button>
            </div>

            <!-- Cart Items List -->
            <div id="validityCartItems" class="bg-[#080a0f] border border-slate-800 rounded-xl p-2.5 space-y-1.5 max-h-36 overflow-y-auto">
                <p class="text-slate-500 text-center py-2">Cart is empty. Select a plan & click Add.</p>
            </div>

            <!-- Backend Summary Display -->
            <div class="bg-[#080a0f] border border-slate-800 rounded-xl p-3 space-y-1.5">
                <div class="flex justify-between">
                    <span class="text-slate-400">Total Validity:</span>
                    <span id="validityTotalDaysText" class="font-mono text-amber-400">0 Days</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-400">Base Total:</span>
                    <span id="validityBasePriceText" class="font-mono">৳ 0.00</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-slate-400">Discount:</span>
                    <span id="validityDiscountText" class="font-mono text-emerald-400">- ৳ 0.00</span>
                </div>
                <div class="flex justify-between border-t border-slate-800 pt-1.5 font-semibold">
                    <span class="text-slate-300">Subtotal:</span>
                    <span id="validitySubtotalText" class="font-mono text-white">৳ 0.00</span>
                </div>
                <div class="flex justify-between text-amber-300">
                    <span>Wallet Deduction:</span>
                    <span id="validityWalletDeductText" class="font-mono">- ৳ 0.00</span>
                </div>
                <div class="flex justify-between border-t border-slate-800 pt-1.5 text-sm font-extrabold text-emerald-400">
                    <span>Grand Total Payable:</span>
