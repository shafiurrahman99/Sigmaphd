// POS Cart & Memo Logic
let cartItems = [];
function addPosItem() {
    const nameInput = document.getElementById('posProductName');
    const qtyInput = document.getElementById('posProductQty');
    const priceInput = document.getElementById('posProductPrice');
    
    const name = nameInput ? nameInput.value.trim() : '';
    const qty = parseInt(qtyInput ? qtyInput.value : 1) || 1;
    const price = parseFloat(priceInput ? priceInput.value : 0) || 0;
    
    if (!name || price <= 0) {
        showAlert("Please enter valid item name and price.");
        return;
    }

    cartItems.push({ name, qty, price, total: qty * price });
    renderCart();
    if(nameInput) nameInput.value = '';
}

function renderCart() {
    const body = document.getElementById('posCartBody');
    if (!body) return;
    let grandTotal = 0;
    body.innerHTML = cartItems.map((item, idx) => {
        grandTotal += item.total;
        return `
            <tr>
                <td class="p-2.5">${item.name}</td>
                <td class="p-2.5 text-center">${item.qty}</td>
                <td class="p-2.5 text-right">৳${item.price}</td>
                <td class="p-2.5 text-right font-bold">৳${item.total}</td>
                <td class="p-2.5 text-center"><button onclick="cartItems.splice(${idx},1);renderCart()" class="text-rose-400 cursor-pointer"><i class="fa-solid fa-trash"></i></button></td>
            </tr>
        `;
    }).join('');
    const totalEl = document.getElementById('posGrandTotal');
    if(totalEl) totalEl.innerText = grandTotal.toFixed(2);
}

function generateCashMemoModal() {
    if (cartItems.length === 0) { showAlert("Cart is empty!"); return; }
    const body = document.getElementById('memoModalBody');
    if(body) {
        body.innerHTML = cartItems.map(item => `
            <tr>
                <td class="border border-slate-300 p-2">${item.name}</td>
                <td class="border border-slate-300 p-2 text-center">${item.qty}</td>
                <td class="border border-slate-300 p-2 text-right">৳${item.price}</td>
                <td class="border border-slate-300 p-2 text-right">৳${item.total}</td>
            </tr>
        `).join('');
    }
    const memoTotal = document.getElementById('memoModalGrandTotal');
    const posTotal = document.getElementById('posGrandTotal');
    if(memoTotal && posTotal) memoTotal.innerText = posTotal.innerText;
    
    const memoModal = document.getElementById('memoModal');
    if(memoModal) memoModal.classList.remove('hidden');
}
