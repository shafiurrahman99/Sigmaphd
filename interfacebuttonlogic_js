}

function attemptValidityExtension() {
    if (validityDaysLeft <= 5) {
        if (walletBalance >= 100) {
            walletBalance -= 100;
            validityDaysLeft += 30;
            renderState();
            closeModal('validityPaymentOptionsModal');
            showAlert("Validity extended by 30 days successfully!");
        } else {
            showAlert("Insufficient wallet balance! Please recharge.");
        }
    } else {
        showAlert("Validity extension becomes available 5 days before expiration.");
    }
}

function calculateTransferFee() {
    const amount = parseFloat(document.getElementById('transferAmount').value) || 0;
    const fee = amount * 0.03;
    const net = amount - fee;
    document.getElementById('feeAmount').innerText = fee.toFixed(2);
    document.getElementById('netReceiverAmount').innerText = net > 0 ? net.toFixed(2) : '0.00';
}

function executeTransfer() {
    const receiver = document.getElementById('transferReceiver').value.trim();
    const amount = parseFloat(document.getElementById('transferAmount').value) || 0;
    if (!receiver || amount <= 0) {
        showAlert("Enter valid receiver ID & transfer amount!");
        return;
    }
    if(walletBalance >= amount) {
        walletBalance -= amount;
        renderState();
        closeModal('p2pTransferModal');
        showAlert(`Successfully transferred ৳${amount} to ${receiver}`);
    } else {
        showAlert("Insufficient wallet balance!");
    }
}

function handlePaymentSubmit(e) {
    if(e) e.preventDefault();
