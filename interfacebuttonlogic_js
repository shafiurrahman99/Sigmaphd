function handleAgentSignIn(e) {
    if(e) e.preventDefault();
    const uid = document.getElementById('agentInputId').value.trim();
    if(uid) {
        isHumanAgentLoggedIn = true;
        humanAgentId = uid;
        document.getElementById('tier1RoleBadge').innerText = "Moderator Active";
        document.getElementById('tier1RoleBadge').className = "text-[9px] text-amber-400 bg-amber-950/60 px-2 py-0.5 rounded-full border border-amber-800/60 font-mono font-bold";
        document.querySelector('input[name="chatModeRadio"][value="human"]').checked = true;
        closeModal('agentAuthModal');
        showAlert(`Signed in as Moderator (${uid})!`);
    }
}

function handleChatModeChange(val) {
    if (val === 'human') {
        openAgentAuthModal();
    } else {
        isHumanAgentLoggedIn = false;
        document.getElementById('tier1RoleBadge').innerText = "Visitor Mode";
        document.getElementById('tier1RoleBadge').className = "text-[9px] text-emerald-400 bg-emerald-950/60 px-2 py-0.5 rounded-full border border-emerald-800/60 font-mono";
        showAlert("Switched to Auto AI Bot mode.");
    }
}

function sendTier1PublicMsg() {
    const input = document.getElementById('tier1PublicMsgInput');
    const txt = input.value.trim();
    if(!txt) return;

    const box = document.getElementById('tier1PublicChatBox');

    if (isHumanAgentLoggedIn) {
        box.innerHTML += `
            <div class="bg-amber-950/40 p-2.5 rounded-xl border border-amber-500/30">
                <div class="flex justify-between text-[10px] text-amber-400 font-bold mb-0.5">
                    <span>🤖 Live AI Assistant</span>
                    <span class="text-slate-500 font-normal">Now</span>
                </div>
                <p class="text-slate-200">${txt}</p>
            </div>
        `;
    } else {
        box.innerHTML += `
            <div class="bg-emerald-950/40 p-2.5 rounded-xl border border-emerald-500/30">
                <div class="flex justify-between text-[10px] text-emerald-400 font-bold mb-0.5">
                    <span>👤 Visitor</span>
                    <span class="text-slate-500 font-normal">Now</span>
                </div>
                <p class="text-slate-200">${txt}</p>
            </div>
        `;

        setTimeout(() => {
            box.innerHTML += `
                <div class="bg-slate-900 p-2.5 rounded-xl border border-slate-800/80">
                    <div class="flex justify-between text-[10px] text-amber-400 font-bold mb-0.5">
                        <span>🤖 Live AI Assistant</span>
                    </div>
                    <p class="text-slate-300">Thank you for your inquiry! Sign in to access full features.</p>
                </div>
            `;
            box.scrollTop = box.scrollHeight;
        }, 600);
    }

    input.value = '';
    box.scrollTop = box.scrollHeight;
}

function showAlert(msg) {
    const alertBox = document.getElementById('systemAlert');
    document.getElementById('systemAlertMsg').innerText = msg;
    alertBox.classList.remove('hidden');
    setTimeout(() => { alertBox.classList.add('hidden'); }, 3000);
}

function toggleYearCollapse(yr) {
    const rows = document.querySelectorAll(`.year${yr}Rows`);
    const icon = document.getElementById(`iconCollapse${yr}`);
    rows.forEach(r => r.classList.toggle('hidden'));
    if(icon) {
        icon.classList.toggle('fa-minus');
        icon.classList.toggle('fa-plus');
    }
}

