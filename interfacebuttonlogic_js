// interfacebuttonlogic.js - UI Handling, Tab Switching & Event Listeners

document.addEventListener('DOMContentLoaded', () => {
    console.log("Interface logic loaded.");
});

// Tab Switching Handler
function switchTab(tabName) {
    const tabs = ['Dashboard', 'CashMemo', 'MyChat', 'Sec', 'Payment'];
    tabs.forEach(t => {
        const el = document.getElementById(`tab${t}View`);
        const btn = document.getElementById(`tab${t}Btn`);
        if (el) el.classList.add('hidden');
        if (btn) btn.className = "px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs rounded-xl transition flex items-center gap-2 cursor-pointer";
    });

    let currentViewId = 'tabDashboardView';
    let currentBtnId = 'tabDashboardBtn';

    if (tabName === 'cashMemo' || tabName === 'CashMemo') {
        currentViewId = 'tabCashMemoView';
        currentBtnId = 'tabCashMemoBtn';
    } else if (tabName === 'myChat' || tabName === 'MyChat') {
        currentViewId = 'tabMyChatView';
        currentBtnId = 'tabMyChatBtn';
    } else if (tabName === 'security' || tabName === 'Sec') {
        currentViewId = 'tabSecurityView';
        currentBtnId = 'tabSecBtn';
    } else if (tabName === 'payment' || tabName === 'Payment') {
        currentViewId = 'tabPaymentView';
        currentBtnId = 'tabPaymentBtn';
    }

    const activeView = document.getElementById(currentViewId);
    const activeBtn = document.getElementById(currentBtnId);
    if (activeView) activeView.classList.remove('hidden');
    if (activeBtn) activeBtn.className = "px-5 py-2.5 bg-emerald-600 text-slate-950 font-bold text-xs rounded-xl transition flex items-center gap-2 cursor-pointer";
}

// Sign-In Handler (Ensures proper view toggle & data loading)
function handleSignIn(e) {
    if (e) e.preventDefault();
    const idVal = document.getElementById('inputUserId').value.trim();
    const passVal = document.getElementById('inputPassword').value.trim();

    if (!idVal || !passVal) {
        showAlert("Please enter User ID and Password.");
        return;
    }

    // Set Global User ID if needed
    currentUserId = idVal;

    document.getElementById('page1View').classList.add('hidden');
    document.getElementById('page2View').classList.remove('hidden');
    document.getElementById('topSignInUser').innerText = `User ID: ${idVal}`;
    showAlert("Signed in successfully!");

    // Trigger data loaders safely
    if (typeof loadFinancialSummary === 'function') loadFinancialSummary();
    if (typeof loadTransactionsFromDB === 'function') loadTransactionsFromDB();
    if (typeof loadInvestmentsFromDB === 'function') loadInvestmentsFromDB();
    if (typeof loadPaymentHistory === 'function') loadPaymentHistory();
}

function handleLogout() {
    document.getElementById('page2View').classList.add('hidden');
    document.getElementById('page1View').classList.remove('hidden');
    showAlert("Logged out successfully.");
}

function sendTier1PublicMsg() {
    const input = document.getElementById('tier1PublicMsgInput');
    if (!input) return;
    const txt = input.value.trim();
    if (!txt) return;
    const box = document.getElementById('tier1PublicChatBox');
    if (!box) return;
    box.innerHTML += `
        <div class="bg-emerald-950/40 p-2.5 rounded-xl border border-emerald-500/30">
            <span class="text-emerald-400 font-bold block text-[10px]">👤 User</span>
            <p class="text-slate-200">${txt}</p>
        </div>
    `;
    input.value = '';
    box.scrollTop = box.scrollHeight;
}

function showAlert(msg) {
    const alertBox = document.getElementById('systemAlert');
    const alertMsg = document.getElementById('systemAlertMsg');
    if (alertBox && alertMsg) {
        alertMsg.innerText = msg;
        alertBox.classList.remove('hidden');
        setTimeout(() => {
            alertBox.classList.add('hidden');
        }, 3000);
    } else {
        alert(msg);
    }
}

