document.addEventListener('DOMContentLoaded', () => {
    if (typeof renderState === 'function') renderState();
    if (typeof renderLoans === 'function') renderLoans();
});

function switchTab(tabName) {
    const tabs = ['Dashboard', 'CashMemo', 'MyChat', 'Sec'];
    tabs.forEach(t => {
        const el = document.getElementById(`tab${t}View`);
        const btn = document.getElementById(`tab${t}Btn`);
        if(el) el.classList.add('hidden');
        if(btn) btn.className = "px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs rounded-xl transition flex items-center gap-2 cursor-pointer";
    });

    let currentViewId = 'tabDashboardView';
    let currentBtnId = 'tabDashBtn';

    if (tabName === 'cashMemo') { currentViewId = 'tabCashMemoView'; currentBtnId = 'tabCashMemoBtn'; }
    else if (tabName === 'myChat') { currentViewId = 'tabMyChatView'; currentBtnId = 'tabMyChatBtn'; }
    else if (tabName === 'security') { currentViewId = 'tabSecurityView'; currentBtnId = 'tabSecBtn'; }

    const activeView = document.getElementById(currentViewId);
    const activeBtn = document.getElementById(currentBtnId);
    if(activeView) activeView.classList.remove('hidden');
    if(activeBtn) activeBtn.className = "px-5 py-2.5 bg-emerald-600 text-slate-950 font-bold text-xs rounded-xl transition flex items-center gap-2 cursor-pointer";
}

function closeModal(id) { 
    const m = document.getElementById(id);
    if(m) m.classList.add('hidden'); 
}

function openModal(id) {
    const m = document.getElementById(id);
    if(m) m.classList.remove('hidden');
}

function openValidityPaymentOptionsModal() { openModal('validityPaymentOptionsModal'); }
function openP2PTransferModal() { openModal('p2pTransferModal'); }
function openPaymentGatewayModal() { 
    closeModal('validityPaymentOptionsModal');
    openModal('paymentGatewayModal'); 
}
function openAccountSettingsModal() { openModal('accountSettingsModal'); }
function openBankSetupModal() { openModal('bankSetupModal'); }
function openAgentAuthModal() { openModal('agentAuthModal'); }
function openIncomeEntryModal() { openModal('incomeEntryModal'); }
function openLoanEntryModal() { openModal('loanEntryModal'); }
function openMarketEntryModal() { openModal('marketEntryModal'); }

function showAlert(msg) {
    const alertBox = document.getElementById('systemAlert');
    const alertMsg = document.getElementById('systemAlertMsg');
    if(alertBox && alertMsg) {
        alertMsg.innerText = msg;
        alertBox.classList.remove('hidden');
        setTimeout(() => { alertBox.classList.add('hidden'); }, 3000);
    } else {
        alert(msg);
    }
}
