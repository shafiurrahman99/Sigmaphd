
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Financial Dashboard &amp; Ledger</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
          colors: {
            navy: {
              950: '#070b14',
              900: '#0c1322',
              850: '#111a2e',
              800: '#16223b',
            }
          }
        }
      }
    };
  </script>
  <style>
    * {
      box-sizing: border-box;
    }
    body {
      font-family: 'Inter', sans-serif;
      background-color: #070b14;
      color: #f1f5f9;
      margin: 0;
      padding: 0;
      overflow-x: hidden;
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: rgba(15, 23, 42, 0.5);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(100, 116, 139, 0.45);
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(148, 163, 184, 0.7);
    }
    .section-fullscreen {
      position: fixed !important;
      inset: 0 !important;
      z-index: 60 !important;
      width: 100vw !important;
      height: 100vh !important;
      max-width: none !important;
      margin: 0 !important;
      border-radius: 0 !important;
      display: flex !important;
      flex-direction: column !important;
      background-color: #0c1322 !important;
      padding: 0.75rem !important;
    }
    @media (orientation: landscape) and (max-height: 600px) {
      .section-fullscreen {
        padding: 0.5rem 0.85rem !important;
      }
    }
    @media (orientation: portrait) {
      .section-fullscreen {
        padding: 0.85rem 0.65rem !important;
      }
    }
    .row-select-cb {
      display: none !important;
    }
    .section-fullscreen .row-select-cb {
      display: table-cell !important;
    }
  </style>
</head>
<body class="bg-navy-950 text-slate-100 min-h-screen antialiased selection:bg-emerald-500/30 selection:text-emerald-200">

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed top-4 right-4 z-[90] flex flex-col gap-2 pointer-events-none max-w-sm"></div>

  <!-- Main Application Shell -->
  <div class="w-full max-w-3xl mx-auto px-3 sm:px-5 py-4 space-y-4">

    <!-- Top Navigation & Active User Scope Bar -->
    <header class="bg-navy-900/95 border border-slate-800/90 rounded-2xl p-2.5 shadow-xl space-y-2">
      <nav class="grid grid-cols-3 gap-2" aria-label="Primary Navigation">
        <button id="tab-btn-dashboard" type="button" onclick="switchTopTab('dashboard')"
          class="py-2.5 px-3 rounded-xl text-xs sm:text-sm font-bold bg-emerald-500 text-slate-950 shadow-md transition-all cursor-pointer">
          Dashboard
        </button>
        <button id="tab-btn-chat" type="button" disabled aria-disabled="true"
          class="py-2.5 px-3 rounded-xl text-xs sm:text-sm font-semibold bg-navy-850/60 text-slate-500 border border-slate-800/70 opacity-60 cursor-not-allowed pointer-events-none">
          My Chat
        </button>
        <button id="tab-btn-memo" type="button" disabled aria-disabled="true"
          class="py-2.5 px-3 rounded-xl text-xs sm:text-sm font-semibold bg-navy-850/60 text-slate-500 border border-slate-800/70 opacity-60 cursor-not-allowed pointer-events-none flex items-center justify-center gap-1.5">
          <span>🧾</span>
          <span>Cash Memo</span>
        </button>
      </nav>

      <!-- Composite User ID & Cloud Sync Status Bar -->
      <div class="flex flex-wrap items-center justify-between gap-2 px-2 py-1 text-[11px] text-slate-400 border-t border-slate-800/70">
        <div class="flex items-center gap-2">
          <span class="text-slate-500">User Scope:</span>
          <span id="active-composite-user-label" class="font-mono font-semibold text-emerald-400 bg-emerald-500/10 border border-emerald-500/25 px-2 py-0.5 rounded-md">
            u101
          </span>
        </div>
        <div class="flex items-center gap-2">
          <span id="sync-status-badge" class="text-slate-400">Local Ready</span>
          <button type="button" onclick="syncLedgerWithRemote()"
            class="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-navy-850 hover:bg-navy-800 text-slate-200 border border-slate-700 cursor-pointer transition-colors">
            ↻ Sync
          </button>
        </div>
      </div>
    </header>

    <!-- ==================== DASHBOARD VIEW ==================== -->
    <main id="view-dashboard" class="space-y-4">

      <!-- 1. Monthly & Yearly Summary Card -->
      <section id="sec-monthly-summary" data-expandable-section
        class="bg-navy-900/95 border border-slate-800/90 rounded-2xl p-4 sm:p-5 shadow-xl space-y-3.5 transition-all select-none">
        <div class="flex flex-wrap items-center justify-between gap-2.5">
          <div class="flex items-center gap-2.5 min-w-0">
            <span class="w-8 h-8 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 flex items-center justify-center font-bold text-base shrink-0">📈</span>
            <div class="min-w-0">
              <h2 class="text-sm sm:text-base font-bold text-slate-100 leading-tight truncate">
                Monthly Summary (Income, Expense, Surplus)
              </h2>
            </div>
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <button type="button" onclick="openIncomeExpenseModal('income')"
              class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold bg-emerald-500 hover:bg-emerald-400 text-slate-950 shadow-lg shadow-emerald-500/20 transition-all cursor-pointer">
              + New Income/Expense
            </button>
            <button type="button" onclick="exitFullscreenSection(false)"
              class="fs-exit-btn hidden px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-600 cursor-pointer">
              ↙ Exit
            </button>
          </div>
        </div>

        <div class="scroll-region overflow-x-auto overflow-y-auto max-h-[168px] rounded-xl border border-slate-800/80 bg-navy-950/60">
          <table class="w-full text-left border-collapse">
            <thead class="sticky top-0 z-10 bg-navy-850">
              <tr class="border-b border-slate-800 text-[11px] sm:text-xs font-semibold text-slate-400">
                <th class="py-2.5 pl-3 pr-2">Period</th>
                <th class="py-2.5 px-2.5">
                  <button type="button" onclick="openIncomeListModal()"
                    title="Click to view all income entries"
                    class="inline-flex items-center gap-1 text-emerald-400 hover:text-emerald-300 underline decoration-emerald-500/40 underline-offset-4 cursor-pointer transition-colors">
                    <span>Total Income (৳)</span>
                    <span class="text-[10px]">↗</span>
                  </button>
                </th>
                <th class="py-2.5 px-2.5">
                  <button type="button" onclick="scrollToSection('sec-daily-expenses')"
                    title="Click to jump to Daily Expenses Log"
                    class="inline-flex items-center gap-1 text-rose-400 hover:text-rose-300 underline decoration-rose-500/40 underline-offset-4 cursor-pointer transition-colors">
                    <span>Total Expense (৳)</span>
                    <span class="text-[10px]">↗</span>
                  </button>
                </th>
                <th class="py-2.5 px-3 text-right">Net Surplus (৳)</th>
              </tr>
            </thead>
            <tbody id="monthly-summary-body" class="divide-y divide-slate-800/60 text-xs sm:text-sm"></tbody>
          </table>
        </div>
      </section>

      <!-- 2. Loan & Credit Records Card -->
      <section id="sec-loan-records"
        class="bg-navy-900/95 border border-slate-800/90 rounded-2xl p-4 sm:p-5 shadow-xl space-y-4 transition-all">
        <div class="flex flex-wrap items-center justify-between gap-2.5">
          <div class="flex items-center gap-2.5 min-w-0">
            <span class="w-8 h-8 rounded-xl bg-amber-500/15 border border-amber-500/30 text-amber-400 flex items-center justify-center text-base shrink-0">💰</span>
            <div class="min-w-0">
              <h2 class="text-sm sm:text-base font-bold text-slate-100 leading-tight">Loan &amp; Credit Records</h2>
            </div>
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <button type="button" onclick="openLoanEntryModal()"
              class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold bg-amber-400 hover:bg-amber-300 text-slate-950 shadow-lg shadow-amber-400/20 transition-all cursor-pointer">
              + New Entry
            </button>
          </div>
        </div>

        <!-- 2A. Receivable Sub-panel -->
        <div id="sec-receivable-panel" data-expandable-section
          class="bg-navy-950/70 border border-slate-800/90 rounded-xl p-3 space-y-2.5 transition-all select-none">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="text-xs sm:text-sm font-bold text-emerald-400">Receivable</span>
              <span id="receivable-due-count-badge" class="text-[11px] px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-300 border border-amber-500/30 font-semibold"></span>
            </div>
            <div class="flex items-center gap-2">
              <button id="btn-delete-receivable" type="button" onclick="deleteSelectedLoans('receivable')"
                class="hidden px-2.5 py-1 rounded-lg text-xs font-bold bg-rose-600 hover:bg-rose-500 text-white shadow cursor-pointer transition-all">
                Delete (<span id="count-del-receivable">0</span>)
              </button>
              <span id="receivable-total-display" class="text-xs sm:text-sm font-bold text-emerald-400">Total Due: ৳ 0.00</span>
              <button type="button" onclick="exitFullscreenSection(false)"
                class="fs-exit-btn hidden px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-600 cursor-pointer">
                ↙ Exit
              </button>
            </div>
          </div>

          <div class="scroll-region overflow-x-auto overflow-y-auto max-h-[164px] rounded-xl border border-slate-800/80 bg-navy-900/70">
            <table class="w-full text-left border-collapse min-w-[600px]">
              <thead class="sticky top-0 z-10 bg-navy-850 text-[11px] font-semibold text-slate-400 border-b border-slate-800">
                <tr>
                  <th class="py-2 pl-2.5 pr-1 w-7 row-select-cb"></th>
                  <th class="py-2 px-2">Description</th>
                  <th class="py-2 px-2">Amount (৳)</th>
                  <th class="py-2 px-2">Receivable Date</th>
                  <th class="py-2 px-2">Received Date</th>
                  <th class="py-2 px-2">Extra (৳)</th>
                  <th class="py-2 pl-2 pr-2.5 text-right">Status</th>
                </tr>
              </thead>
              <tbody id="receivable-list-body" class="divide-y divide-slate-800/60 text-xs"></tbody>
            </table>
          </div>
        </div>

        <!-- 2B. Payable Sub-panel -->
        <div id="sec-payable-panel" data-expandable-section
          class="bg-navy-950/70 border border-slate-800/90 rounded-xl p-3 space-y-2.5 transition-all select-none">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="text-xs sm:text-sm font-bold text-rose-400">Payable</span>
              <span id="payable-due-count-badge" class="text-[11px] px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-300 border border-amber-500/30 font-semibold"></span>
            </div>
            <div class="flex items-center gap-2">
              <button id="btn-delete-payable" type="button" onclick="deleteSelectedLoans('payable')"
                class="hidden px-2.5 py-1 rounded-lg text-xs font-bold bg-rose-600 hover:bg-rose-500 text-white shadow cursor-pointer transition-all">
                Delete (<span id="count-del-payable">0</span>)
              </button>
              <span id="payable-total-display" class="text-xs sm:text-sm font-bold text-rose-400">Total Due: ৳ 0.00</span>
              <button type="button" onclick="exitFullscreenSection(false)"
                class="fs-exit-btn hidden px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-600 cursor-pointer">
                ↙ Exit
              </button>
            </div>
          </div>

          <div class="scroll-region overflow-x-auto overflow-y-auto max-h-[164px] rounded-xl border border-slate-800/80 bg-navy-900/70">
            <table class="w-full text-left border-collapse min-w-[600px]">
              <thead class="sticky top-0 z-10 bg-navy-850 text-[11px] font-semibold text-slate-400 border-b border-slate-800">
                <tr>
                  <th class="py-2 pl-2.5 pr-1 w-7 row-select-cb"></th>
                  <th class="py-2 px-2">Description</th>
                  <th class="py-2 px-2">Amount (৳)</th>
                  <th class="py-2 px-2">Payable Date</th>
                  <th class="py-2 px-2">Paid Date</th>
                  <th class="py-2 px-2">Extra (৳)</th>
                  <th class="py-2 pl-2 pr-2.5 text-right">Status</th>
                </tr>
              </thead>
              <tbody id="payable-list-body" class="divide-y divide-slate-800/60 text-xs"></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- 3. Daily Expenses Log Card -->
      <section id="sec-daily-expenses" data-expandable-section
        class="bg-navy-900/95 border border-slate-800/90 rounded-2xl p-4 sm:p-5 shadow-xl space-y-3.5 transition-all select-none">
        <div class="flex flex-wrap items-center justify-between gap-2.5">
          <div class="flex items-center gap-2.5 min-w-0">
            <span class="w-8 h-8 rounded-xl bg-violet-500/15 border border-violet-500/30 text-violet-300 flex items-center justify-center text-base shrink-0">🛒</span>
            <div class="min-w-0">
              <h2 class="text-sm sm:text-base font-bold text-slate-100 leading-tight">
                Daily Expenses Log (Auto Expense Sync)
              </h2>
            </div>
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <button id="btn-delete-expenses" type="button" onclick="deleteSelectedExpenses()"
              class="hidden px-2.5 py-2 rounded-xl text-xs font-bold bg-rose-600 hover:bg-rose-500 text-white shadow cursor-pointer transition-all">
              Delete (<span id="count-del-expenses">0</span>)
            </button>
            <button type="button" onclick="openDailyExpenseModal()"
              class="px-3.5 py-2 rounded-xl text-xs sm:text-sm font-bold bg-violet-600 hover:bg-violet-500 text-white shadow-lg shadow-violet-600/20 transition-all cursor-pointer">
              + New Expense Entry
            </button>
            <button type="button" onclick="exitFullscreenSection(false)"
              class="fs-exit-btn hidden px-2.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-600 cursor-pointer">
              ↙ Exit
            </button>
          </div>
        </div>

        <div class="scroll-region overflow-x-auto overflow-y-auto max-h-[168px] rounded-xl border border-slate-800/80 bg-navy-950/60">
          <table class="w-full text-left border-collapse min-w-[460px]">
            <thead class="sticky top-0 z-10 bg-navy-850 text-[11px] sm:text-xs font-semibold text-slate-400 border-b border-slate-800">
              <tr>
                <th class="py-2.5 pl-3 pr-1 w-7 row-select-cb"></th>
                <th class="py-2.5 px-2.5">Date</th>
                <th class="py-2.5 px-2.5">Description</th>
                <th class="py-2.5 px-2.5">Amount (৳)</th>
                <th class="py-2.5 pl-2.5 pr-3 text-right">Status &amp; Action</th>
              </tr>
            </thead>
            <tbody id="daily-expenses-body" class="divide-y divide-slate-800/60 text-xs sm:text-sm"></tbody>
          </table>
        </div>
      </section>
    </main>

    <!-- ==================== MY CHAT VIEW ==================== -->
    <section id="view-chat" class="hidden bg-navy-900/95 border border-slate-800/90 rounded-2xl p-4 sm:p-5 shadow-xl space-y-4">
      <div class="flex items-center justify-between border-b border-slate-800 pb-3">
        <div>
          <h2 class="text-base font-bold text-slate-100">Ledger Notes &amp; Quick Log</h2>
          <p class="text-xs text-slate-400">Keep quick financial notes or reminders alongside your ledger.</p>
        </div>
        <span class="text-xs px-2.5 py-1 rounded-full bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 font-semibold">Active</span>
      </div>
      <div id="chat-messages-list" class="space-y-2.5 max-h-[300px] overflow-y-auto pr-1"></div>
      <form id="chat-note-form" onsubmit="handleChatSubmit(event)" class="flex gap-2 pt-1">
        <input id="chat-note-input" type="text" required placeholder="Write a note..."
          class="flex-1 bg-navy-950 border border-slate-700 focus:border-emerald-500 rounded-xl px-3.5 py-2.5 text-sm text-slate-100 outline-none" />
        <button type="submit"
          class="px-4 py-2.5 rounded-xl text-sm font-bold bg-emerald-500 hover:bg-emerald-400 text-slate-950 cursor-pointer transition-all">
          Send
        </button>
      </form>
    </section>

    <!-- ==================== CASH MEMO VIEW ==================== -->
    <section id="view-memo" class="hidden bg-navy-900/95 border border-slate-800/90 rounded-2xl p-4 sm:p-5 shadow-xl space-y-4">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 pb-3">
        <div>
          <h2 class="text-base font-bold text-slate-100">Cash Memo &amp; Ledger Backup</h2>
          <p class="text-xs text-slate-400">All data persists automatically in local storage and syncs via composite_user_id.</p>
        </div>
        <button type="button" onclick="resetSampleData()"
          class="px-3.5 py-2 rounded-xl text-xs font-bold bg-amber-500 hover:bg-amber-400 text-slate-950 cursor-pointer transition-all">
          Reset Sample Data
        </button>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="bg-navy-950/80 border border-slate-800 rounded-xl p-3.5">
          <p class="text-xs text-slate-400">Total Income</p>
          <p id="memo-total-income" class="text-lg font-extrabold text-emerald-400 mt-1">৳ 0.00</p>
        </div>
        <div class="bg-navy-950/80 border border-slate-800 rounded-xl p-3.5">
          <p class="text-xs text-slate-400">Total Paid Expense</p>
          <p id="memo-total-expense" class="text-lg font-extrabold text-rose-400 mt-1">৳ 0.00</p>
        </div>
        <div class="bg-navy-950/80 border border-slate-800 rounded-xl p-3.5">
          <p class="text-xs text-slate-400">Net Surplus</p>
          <p id="memo-net-surplus" class="text-lg font-extrabold text-sky-400 mt-1">৳ 0.00</p>
        </div>
      </div>
    </section>

  </div>

  <!-- ==================== MODAL 1: NEW INCOME / EXPENSE ==================== -->
  <div id="modal-income-expense" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/75 backdrop-blur-xs p-3">
    <div class="bg-navy-900 border border-slate-700/90 rounded-2xl w-full max-w-md p-5 shadow-2xl space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-base font-bold text-slate-100">+ New Income / Expense</h3>
        <button type="button" onclick="closeModal('modal-income-expense')" class="text-slate-400 hover:text-white text-lg leading-none cursor-pointer">✕</button>
      </div>

      <form id="form-income-expense" onsubmit="handleIncomeExpenseSubmit(event)" class="space-y-3.5">
        <div class="grid grid-cols-2 gap-2 bg-navy-950 p-1 rounded-xl border border-slate-800">
          <button id="btn-type-income" type="button" onclick="setIEModalType('income')"
            class="py-2 rounded-lg text-xs sm:text-sm font-bold bg-emerald-500 text-slate-950 cursor-pointer transition-all">
            + Income
          </button>
          <button id="btn-type-expense" type="button" onclick="setIEModalType('expense')"
            class="py-2 rounded-lg text-xs sm:text-sm font-semibold text-slate-300 hover:text-white cursor-pointer transition-all">
            − Expense (Paid)
          </button>
        </div>

        <div id="income-list-radio-box" class="bg-navy-950/80 border border-emerald-500/25 rounded-xl p-2.5 flex items-center justify-between gap-2">
          <label class="flex items-center gap-2 text-xs font-semibold text-emerald-300 cursor-pointer">
            <input id="radio-view-income-list" type="radio" name="incomeViewRadio"
              onchange="if (this.checked) { closeModal('modal-income-expense'); openIncomeListModal(); this.checked = false; }"
              class="w-4 h-4 accent-emerald-400 cursor-pointer" />
            <span>View Date-wise Total Income Entries List</span>
          </label>
          <span class="text-[11px] text-slate-400">List ↗</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Date</label>
            <input id="ie-date" type="date" required
              class="w-full bg-navy-950 border border-slate-700 focus:border-emerald-500 rounded-xl px-3 py-2 text-sm text-slate-100 outline-none" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Amount (৳)</label>
            <input id="ie-amount" type="number" step="0.01" min="0.01" required placeholder="0.00"
              class="w-full bg-navy-950 border border-slate-700 focus:border-emerald-500 rounded-xl px-3 py-2 text-sm text-slate-100 outline-none" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Description</label>
          <input id="ie-description" type="text" required placeholder="e.g., Client Payment / Office Lunch"
            class="w-full bg-navy-950 border border-slate-700 focus:border-emerald-500 rounded-xl px-3 py-2 text-sm text-slate-100 outline-none" />
        </div>

        <div class="flex justify-end gap-2 pt-1">
          <button type="button" onclick="closeModal('modal-income-expense')"
            class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-slate-800 hover:bg-slate-700 text-slate-300 cursor-pointer">
            Cancel
          </button>
          <button type="submit"
            class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-emerald-500 hover:bg-emerald-400 text-slate-950 cursor-pointer">
            Save Entry
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ==================== MODAL 2: NEW LOAN / CREDIT ENTRY ==================== -->
  <div id="modal-loan-entry" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/75 backdrop-blur-xs p-3">
    <div class="bg-navy-900 border border-slate-700/90 rounded-2xl w-full max-w-md p-5 shadow-2xl space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-base font-bold text-slate-100">+ New Loan / Credit Entry</h3>
        <button type="button" onclick="closeModal('modal-loan-entry')" class="text-slate-400 hover:text-white text-lg leading-none cursor-pointer">✕</button>
      </div>

      <form id="form-loan-entry" onsubmit="handleLoanEntrySubmit(event)" class="space-y-3.5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Record Type</label>
            <select id="loan-direction" onchange="updateLoanEntryHint()"
              class="w-full bg-navy-950 border border-slate-700 focus:border-amber-400 rounded-xl px-3 py-2 text-sm text-slate-100 outline-none">
              <option value="receivable">Receivable</option>
              <option value="payable">Payable</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Status</label>
            <select id="loan-status"
              class="w-full bg-navy-950 border border-slate-700 focus:border-amber-400 rounded-xl px-3 py-2 text-sm text-slate-100 outline-none">
              <option value="Due">Due</option>
              <option value="Paid">Paid</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Description / Party Name</label>
          <input id="loan-description" type="text" required placeholder="e.g., Mayurganj Loan / Rahim"
            class="w-full bg-navy-950 border border-slate-700 focus:border-amber-400 rounded-xl px-3 py-2 text-sm text-slate-100 outline-none" />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Amount (৳)</label>
            <input id="loan-amount" type="number" step="0.01" min="0.01" required placeholder="0.00"
              class="w-full bg-navy-950 border border-slate-700 focus:border-amber-400 rounded-xl px-3 py-2 text-sm text-slate-100 outline-none" />
          </div>
          <div>
            <label id="loan-date-label" class="block text-xs font-semibold text-slate-300 mb-1">Receivable Date</label>
            <input id="loan-date" type="date" required
              class="w-full bg-navy-950 border border-slate-700 focus:border-amber-400 rounded-xl px-3 py-2 text-sm text-slate-100 outline-none" />
          </div>
        </div>

        <div class="flex justify-end gap-2 pt-1">
          <button type="button" onclick="closeModal('modal-loan-entry')"
            class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-slate-800 hover:bg-slate-700 text-slate-300 cursor-pointer">
            Cancel
          </button>
          <button type="submit"
            class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-amber-400 hover:bg-amber-300 text-slate-950 cursor-pointer">
            Save Entry
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ==================== MODAL 3: SETTLE RECEIVABLE DUE ==================== -->
  <div id="modal-receivable-settle" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/75 backdrop-blur-xs p-3">
    <div class="bg-navy-900 border border-slate-700/90 rounded-2xl w-full max-w-md p-5 shadow-2xl space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-base font-bold text-emerald-400">Receive Due Amount</h3>
        <button type="button" onclick="closeModal('modal-receivable-settle')" class="text-slate-400 hover:text-white text-lg leading-none cursor-pointer">✕</button>
      </div>

      <form id="form-receivable-settle" onsubmit="handleReceivableSettleSubmit(event)" class="space-y-3.5">
        <input id="rec-settle-id" type="hidden" />
        <div class="bg-navy-950/90 border border-slate-800 rounded-xl p-3 text-xs space-y-1">
          <div class="flex justify-between">
            <span class="text-slate-400">Description:</span>
            <span id="rec-settle-desc" class="font-bold text-slate-100"></span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">Principal Amount:</span>
            <span id="rec-settle-principal" class="font-bold text-emerald-400"></span>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Receive Date</label>
            <input id="rec-settle-date" type="date" required
              class="w-full bg-navy-950 border border-slate-700 focus:border-emerald-500 rounded-xl px-3 py-2 text-sm text-slate-100 outline-none" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Extra Amount (৳)</label>
            <input id="rec-settle-extra" type="number" step="0.01" min="0" value="0"
              class="w-full bg-navy-950 border border-slate-700 focus:border-emerald-500 rounded-xl px-3 py-2 text-sm text-slate-100 outline-none" />
          </div>
        </div>

        <div class="flex justify-end gap-2 pt-1">
          <button type="button" onclick="closeModal('modal-receivable-settle')"
            class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-slate-800 hover:bg-slate-700 text-slate-300 cursor-pointer">
            Cancel
          </button>
          <button type="submit"
            class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-emerald-500 hover:bg-emerald-400 text-slate-950 cursor-pointer">
            Confirm
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ==================== MODAL 4: SETTLE PAYABLE DUE ==================== -->
  <div id="modal-payable-settle" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/75 backdrop-blur-xs p-3">
    <div class="bg-navy-900 border border-slate-700/90 rounded-2xl w-full max-w-md p-5 shadow-2xl space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-base font-bold text-rose-400">Payable Due Payment</h3>
        <button type="button" onclick="closeModal('modal-payable-settle')" class="text-slate-400 hover:text-white text-lg leading-none cursor-pointer">✕</button>
      </div>

      <form id="form-payable-settle" onsubmit="handlePayableSettleSubmit(event)" class="space-y-3.5">
        <input id="pay-settle-id" type="hidden" />
        <div class="bg-navy-950/90 border border-slate-800 rounded-xl p-3 text-xs space-y-1">
          <div class="flex justify-between">
            <span class="text-slate-400">Description:</span>
            <span id="pay-settle-desc" class="font-bold text-slate-100"></span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">Principal Amount:</span>
            <span id="pay-settle-principal" class="font-bold text-rose-400"></span>
          </div>
          <div class="flex justify-between">
            <span class="text-slate-400">Source:</span>
            <span id="pay-settle-source" class="font-semibold text-slate-300"></span>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Payment Date</label>
            <input id="pay-settle-date" type="date" required
              class="w-full bg-navy-950 border border-slate-700 focus:border-rose-500 rounded-xl px-3 py-2 text-sm text-slate-100 outline-none" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Extra Amount (৳)</label>
            <input id="pay-settle-extra" type="number" step="0.01" min="0" value="0"
              class="w-full bg-navy-950 border border-slate-700 focus:border-rose-500 rounded-xl px-3 py-2 text-sm text-slate-100 outline-none" />
          </div>
        </div>

        <div class="flex justify-end gap-2 pt-1">
          <button type="button" onclick="closeModal('modal-payable-settle')"
            class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-slate-800 hover:bg-slate-700 text-slate-300 cursor-pointer">
            Cancel
          </button>
          <button type="submit"
            class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-rose-500 hover:bg-rose-400 text-white cursor-pointer">
            Confirm
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ==================== MODAL 5: DAILY EXPENSE ENTRY ==================== -->
  <div id="modal-daily-expense" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/75 backdrop-blur-xs p-3">
    <div class="bg-navy-900 border border-slate-700/90 rounded-2xl w-full max-w-md p-5 shadow-2xl space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-base font-bold text-violet-300">+ Daily Expense Entry</h3>
        <button type="button" onclick="closeModal('modal-daily-expense')" class="text-slate-400 hover:text-white text-lg leading-none cursor-pointer">✕</button>
      </div>

      <form id="form-daily-expense" onsubmit="handleDailyExpenseSubmit(event)" class="space-y-3.5">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Date</label>
            <input id="dexp-date" type="date" required
              class="w-full bg-navy-950 border border-slate-700 focus:border-violet-500 rounded-xl px-3 py-2 text-sm text-slate-100 outline-none" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1">Amount (৳)</label>
            <input id="dexp-amount" type="number" step="0.01" min="0.01" required placeholder="0.00"
              class="w-full bg-navy-950 border border-slate-700 focus:border-violet-500 rounded-xl px-3 py-2 text-sm text-slate-100 outline-none" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Description</label>
          <input id="dexp-description" type="text" required placeholder="e.g., Transport / Grocery / Bill"
            class="w-full bg-navy-950 border border-slate-700 focus:border-violet-500 rounded-xl px-3 py-2 text-sm text-slate-100 outline-none" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1">Status</label>
          <select id="dexp-status"
            class="w-full bg-navy-950 border border-slate-700 focus:border-violet-500 rounded-xl px-3 py-2 text-sm text-slate-100 outline-none">
            <option value="Paid">Paid</option>
            <option value="Due">Due</option>
          </select>
        </div>

        <div class="flex justify-end gap-2 pt-1">
          <button type="button" onclick="closeModal('modal-daily-expense')"
            class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold bg-slate-800 hover:bg-slate-700 text-slate-300 cursor-pointer">
            Cancel
          </button>
          <button type="submit"
            class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-violet-600 hover:bg-violet-500 text-white cursor-pointer">
            Save Expense
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- ==================== MODAL 6: ALL INCOME ENTRIES (DATE-WISE) ==================== -->
  <div id="modal-income-list" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/75 backdrop-blur-xs p-3">
    <div class="bg-navy-900 border border-slate-700/90 rounded-2xl w-full max-w-2xl p-5 shadow-2xl space-y-4 max-h-[85vh] flex flex-col">
      <div class="flex items-center justify-between gap-2">
        <div>
          <h3 class="text-base font-bold text-emerald-400">All Total Income Entries (Date-wise)</h3>
          <p class="text-[11px] text-slate-400">Select rows with checkbox to delete from ledger</p>
        </div>
        <div class="flex items-center gap-2">
          <button id="btn-delete-incomes" type="button" onclick="deleteSelectedIncomes()"
            class="hidden px-3 py-1.5 rounded-xl text-xs font-bold bg-rose-600 hover:bg-rose-500 text-white shadow cursor-pointer transition-all">
            Delete (<span id="count-del-incomes">0</span>)
          </button>
          <button type="button" onclick="closeModal('modal-income-list')"
            class="text-slate-400 hover:text-white text-lg leading-none px-2 py-1 cursor-pointer">✕</button>
        </div>
      </div>

      <div class="overflow-x-auto overflow-y-auto flex-1 rounded-xl border border-slate-800 bg-navy-950/70">
        <table class="w-full text-left border-collapse min-w-[460px]">
          <thead class="sticky top-0 z-10 bg-navy-850 text-[11px] sm:text-xs font-semibold text-slate-400 border-b border-slate-800">
            <tr>
              <th class="py-2.5 pl-3 pr-1 w-7"></th>
              <th class="py-2.5 px-2.5">Date</th>
              <th class="py-2.5 px-2.5">Description</th>
              <th class="py-2.5 pl-2.5 pr-3 text-right">Amount (৳)</th>
            </tr>
          </thead>
          <tbody id="income-list-modal-body" class="divide-y divide-slate-800/60 text-xs sm:text-sm"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Load Root Proxy & Application Controller -->
  <script src="./root-proxy.js"></script>
  <script src="./script.js"></script>
</body>
</html>