    <!-- Script Section for Logic -->
    <script>
        let activePrivateUser = null;

        function showToast(text) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-text').innerText = text;
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3500);
        }

        function hideToast() {
            document.getElementById('toast').classList.add('hidden');
        }

        function formatMoney(amount) {
            return '৳ ' + Number(amount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function updateFinancialDisplays() {
            document.getElementById('walletBalanceText').innerText = formatMoney(currentWalletBalance);
            document.getElementById('modalWalletBalance').innerText = formatMoney(currentWalletBalance);

            document.getElementById('accountValidityDays').innerText = currentValidityDays;
            document.getElementById('currentValidityInModal').innerText = currentValidityDays + ' Days';

            document.getElementById('activeDeviceCount').innerText = activeDevices;
            document.getElementById('subUserCount').innerText = totalSubUsers;

            document.getElementById('runningMonthIncome').innerText = formatMoney(runningIncome);
            document.getElementById('runningMonthExpense').innerText = formatMoney(runningExpense);
            document.getElementById('runningMonthSurplus').innerText = formatMoney(runningIncome - runningExpense);

            document.getElementById('totalIncome2026').innerText = formatMoney(totalIncome2026);
            document.getElementById('totalExpense2026').innerText = formatMoney(totalExpense2026);
            document.getElementById('totalSurplus2026').innerText = formatMoney(totalIncome2026 - totalExpense2026);

            document.getElementById('loanGivenTotalText').innerText = 'Total: ' + formatMoney(loanGivenTotal);
            document.getElementById('loanTakenTotalText').innerText = 'Total: ' + formatMoney(loanTakenTotal);
        }

        // Page Navigation
        function handleMainSignIn(event) {
            event.preventDefault();
            const userId = document.getElementById('mainUserId').value;
            const companyId = document.getElementById('signInCompanyId').value;
            if(!userId) return;
            document.getElementById('currentLoggedInUser').innerText = userId + ' (Co: ' + companyId + ')';
            document.getElementById('page1').classList.add('hidden');
            document.getElementById('page2').classList.remove('hidden');
            showToast('Successfully signed in to Dashboard (Company ID: ' + companyId + ')!');
        }

        function handleLogOut() {
            document.getElementById('page2').classList.add('hidden');
            document.getElementById('page1').classList.remove('hidden');
            showToast('Logged out successfully');
        }

