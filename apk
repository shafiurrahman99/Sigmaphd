        // Cash Memo Handlers & Dual Mode
        function openCashMemoModal() {
            document.getElementById('memoDate').innerText = new Date().toLocaleDateString('en-GB');
            document.getElementById('memoRandomNum').innerText = Math.floor(1000 + Math.random() * 9000);
            switchMemoMode('platform');
            document.getElementById('cashMemoModal').classList.remove('hidden');
        }

        function closeCashMemoModal() { document.getElementById('cashMemoModal').classList.add('hidden'); }

        function switchMemoMode(mode) {
            const bizInputs = document.getElementById('businessMemoInputs');
            const headerTitle = document.getElementById('memoHeaderTitle');
            const headerSub = document.getElementById('memoHeaderSub');
            const tableBody = document.getElementById('memoTableBody');
            const totalDisplay = document.getElementById('memoTotalAmount');
            const userDisplay = document.getElementById('memoUserDisplay');

            if(mode === 'platform') {
                bizInputs.classList.add('hidden');
                headerTitle.innerText = "MY DEVELOP APP";
                headerSub.innerText = "Sigma PhD™ Platform Services (Co. ID: 105)";
                userDisplay.innerText = document.getElementById('currentLoggedInUser').innerText;

                tableBody.innerHTML = `
                    <tr>
                        <td class="p-2 border-r border-slate-200">Device License & Service Activation</td>
                        <td class="p-2 border-r border-slate-200 text-center">1 Unit</td>
                        <td class="p-2 text-right">৳ 500.00</td>
                    </tr>
                    <tr>
                        <td class="p-2 border-r border-slate-200">Wallet Top-Up & Cashback Credit</td>
                        <td class="p-2 border-r border-slate-200 text-center">1 Unit</td>
                        <td class="p-2 text-right">৳ 2100.00</td>
                    </tr>
                `;
                totalDisplay.innerText = "৳ 2600.00";
            } else {
                bizInputs.classList.remove('hidden');
                headerTitle.innerText = "USER BUSINESS MEMO";
                headerSub.innerText = "Personal Customer Invoice (Co. ID: 105)";
                updateBusinessMemo();
            }
        }

        function updateBusinessMemo() {
            const name = document.getElementById('custNameInput').value.trim() || 'Valued Customer';
            const item = document.getElementById('custItemDesc').value.trim() || 'Item Description';
            const qty = parseFloat(document.getElementById('custQty').value) || 1;
            const rate = parseFloat(document.getElementById('custRate').value) || 0;
            const total = qty * rate;

            document.getElementById('memoUserDisplay').innerText = name;
            document.getElementById('memoTableBody').innerHTML = `
                <tr>
                    <td class="p-2 border-r border-slate-200">${item}</td>
                    <td class="p-2 border-r border-slate-200 text-center">${qty} Unit(s)</td>
                    <td class="p-2 text-right">৳ ${total.toFixed(2)}</td>
                </tr>
            `;
            document.getElementById('memoTotalAmount').innerText = `৳ ${total.toFixed(2)}`;
        }

        function printCashMemo() {
            const printContents = document.getElementById('printableCashMemoCard').outerHTML;
            const originalContents = document.body.innerHTML;
            document.body.innerHTML = `<div style="padding:20px; background:#fff;">${printContents}</div>`;
            window.print();
            document.body.innerHTML = originalContents;
            window.location.reload();
        }

        function downloadPDFMemo() {
            showToast('Downloading cash memo in PDF format (Co ID: 105)...');
            setTimeout(() => {
                printCashMemo();
            }, 800);
        }

        // Initialize Defaults
        window.addEventListener('DOMContentLoaded', () => {
            const today = new Date().toISOString().split('T')[0];
            if(document.getElementById('marketDate')) document.getElementById('marketDate').value = today;
            if(document.getElementById('incomeDate')) document.getElementById('incomeDate').value = today;
            updateFinancialDisplays();
        });
    </script>
