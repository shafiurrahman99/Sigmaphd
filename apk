<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Develop App - Dashboard</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        bgMain: '#07090d',
                        cardBg: '#131822',
                        innerDark: '#080a0f',
                        accentGreen: '#0fa968',
                        accentOrange: '#f59e0b',
                    },
                    fontFamily: {
                        sans: ['Inter', 'Hind Siliguri', 'sans-serif'],
                        bengali: ['Hind Siliguri', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Inter', 'Hind Siliguri', sans-serif;
            background-color: #07090d;
            color: #e2e8f0;
            user-select: none;
        }

        .gradient-text {
            background: linear-gradient(135deg, #f59e0b 0%, #ef4444 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .buy-btn-gradient {
            background: linear-gradient(90deg, #f59e0b 0%, #f43f5e 50%, #ec4899 100%);
            transition: all 0.3s ease;
        }

        .buy-btn-gradient:hover {
            opacity: 0.95;
            transform: translateY(-1px);
        }

        ::-webkit-scrollbar {
            width: 5px;
        }
        ::-webkit-scrollbar-track {
            background: #0d1117;
        }
        ::-webkit-scrollbar-thumb {
            background: #1f293d;
            border-radius: 10px;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-start p-2 sm:p-4 bg-slate-950">

    <!-- Global State Variables -->
    <script>
        const GLOBAL_COMPANY_ID = 105;
        let currentUserId = "8942"; 
        let currentCompositeUserId = "105_8942"; 
        let currentUserMobile = "01818589423"; 
        
        let isModeratorLoggedIn = false;
        let currentWalletBalance = 2100.00;
        let currentValidityDays = 25;
        let activeDevices = 1;
        let totalSubUsers = 5;

        let runningIncome = 25000.00;
        let runningExpense = 5500.00;
        let totalIncome2026 = 55508.00;
        let totalExpense2026 = 23308.00;

        let loanGivenTotal = 3000.00;
        let loanTakenTotal = 4000.00;
    </script>

    <!-- Toast Notification -->
    <div id="toast" class="hidden fixed top-4 left-1/2 -translate-x-1/2 z-[100] w-11/12 max-w-md bg-emerald-600 text-white px-4 py-3 rounded-xl shadow-2xl flex items-center justify-between text-sm font-medium transition-all duration-300">
        <span id="toast-text">Action successful!</span>
        <button onclick="hideToast()" class="text-white hover:text-emerald-200 ml-2">
            <i class="fa-solid fa-xmark text-base"></i>
        </button>
    </div>

    <!-- ================= PAGE 1: LOGIN & LANDING ================= -->
    <div id="page1" class="w-full max-w-md mx-auto space-y-4 my-auto py-4">
        <div class="bg-[#131822] rounded-3xl p-5 sm:p-6 shadow-2xl border border-slate-800/80 relative overflow-hidden">
            <div class="flex items-start justify-between mb-5">
                <div>
                    <h1 class="text-2xl font-extrabold text-white tracking-tight">My Develop App</h1>
                    <p class="font-bengali text-emerald-400 font-semibold text-sm mt-0.5 tracking-wide">নিজের হাতের গড়া</p>
                </div>
                <div class="text-right">
                    <span class="gradient-text font-black text-lg italic tracking-wider block">Sigma PhD™</span>
                    <span class="text-[10px] text-slate-400 font-mono">Company ID: <strong class="text-amber-400">105</strong></span>
                </div>
            </div>

            <!-- Sign In Form -->
            <form onsubmit="handleMainSignIn(event)" class="space-y-4">
                <input type="hidden" id="signInCompanyId" value="105">
                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1.5 ml-1">4-Digit User ID or Mobile</label>
                    <input type="text" id="mainUserId" value="8942" required
                        class="w-full bg-[#080a0f] border border-slate-700/60 rounded-2xl py-3 px-4 text-emerald-400 font-medium tracking-wide focus:outline-none focus:border-emerald-500 transition-all text-sm">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1.5 ml-1">Password</label>
                    <div class="relative">
                        <input type="password" id="mainUserPassword" value="123456" required
                            class="w-full bg-[#080a0f] border border-slate-700/60 rounded-2xl py-3 px-4 text-emerald-400 font-medium tracking-widest focus:outline-none focus:border-emerald-500 transition-all text-sm">
                    </div>
                </div>

                <button type="submit" 
                    class="w-full bg-[#0fa968] hover:bg-[#0c8e57] text-slate-950 font-bold py-3.5 px-4 rounded-2xl flex items-center justify-center space-x-2 transition-all active:scale-95 shadow-lg shadow-emerald-900/20 text-base mt-2">
                    <span>Sign In</span>
                    <i class="fa-solid fa-arrow-right text-sm"></i>
                </button>
            </form>

            <div class="my-4 border-t border-slate-800"></div>

            <button type="button" onclick="openBuyLicenseLandingModal()" 
                class="w-full buy-btn-gradient text-slate-950 font-extrabold py-3.5 px-4 rounded-2xl flex items-center justify-center space-x-2 shadow-lg active:scale-95 text-base">
                <i class="fa-solid fa-credit-card text-base text-slate-900"></i>
                <span>Buy New ID / License</span>
            </button>
        </div>

        <!-- Bottom Card: AI Assistant Forum -->
        <div class="bg-[#131822] rounded-3xl p-5 sm:p-6 shadow-2xl border border-slate-800/80 space-y-4">
            <div class="flex items-center justify-between text-xs sm:text-sm">
                <div class="flex items-center space-x-2">
                    <span class="relative flex h-3 w-3">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                    </span>
                    <button onclick="openModLoginModal()" class="text-emerald-400 font-bold hover:underline transition-all">
                        24/7 active AI assistant
                    </button>
                    <span class="text-slate-400 font-normal">& Open Public Forum</span>
                </div>
                <span id="modeBadge" class="bg-[#0e271f] text-emerald-400 border border-emerald-800/50 px-2.5 py-1 rounded-full text-[11px] font-semibold">
                    Visitor Mode
                </span>
            </div>

            <div id="chatBox" class="bg-[#080a0f] border border-slate-800 rounded-2xl p-3 h-52 overflow-y-auto space-y-3 flex flex-col">
                <div class="bg-[#18202d] border border-slate-800 rounded-xl p-3 shadow-sm max-w-[92%] self-start space-y-1">
                    <div class="flex items-center justify-between text-xs mb-1">
                        <div class="flex items-center space-x-1.5 text-amber-400 font-bold">
                            <span>🤖</span>
                            <span>Live AI Assistant (Composite ID: 105_8942)</span>
                        </div>
                        <span class="text-[10px] text-slate-500">Now</span>
                    </div>
                    <p class="text-slate-300 text-xs leading-relaxed">
                        Welcome Public Visitors! Click "<span class="text-emerald-400 cursor-pointer font-semibold hover:underline" onclick="openModLoginModal()">24/7 active AI assistant</span>" link to sign in as Moderator.
                    </p>
                </div>
            </div>

            <form onsubmit="handleSendMessage(event)" class="flex items-center space-x-2 pt-1">
                <input type="text" id="chatInput" placeholder="Type message as visitor or moderator..." 
                    class="flex-1 bg-[#080a0f] border border-slate-700/70 rounded-2xl py-3 px-4 text-xs sm:text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-emerald-500">
                <button type="submit" 
                    class="bg-[#0fa968] hover:bg-[#0c8e57] text-slate-950 font-bold py-3 px-4 rounded-2xl flex items-center space-x-1.5 transition-all text-xs sm:text-sm active:scale-95 shrink-0">
                    <span>Send</span>
                    <i class="fa-solid fa-paper-plane text-xs"></i>
                </button>
            </form>
        </div>
    </div>


    <!-- ================= PAGE 2: DASHBOARD ================= -->
    <div id="page2" class="hidden w-full max-w-md mx-auto space-y-4 py-2">
        <div class="bg-[#131822] border border-slate-800/80 rounded-2xl p-4 flex items-center justify-between shadow-xl">
            <div class="flex items-center space-x-3">
                <div class="relative cursor-pointer" onclick="openAddDeviceModal()" title="Add New Device">
                    <div class="w-10 h-10 bg-emerald-950/80 border border-emerald-500/40 rounded-xl flex items-center justify-center text-emerald-400 text-lg">
                        <i class="fa-solid fa-mobile-screen-button"></i>
                    </div>
                    <span class="absolute -top-1.5 -right-1.5 bg-emerald-500 text-slate-950 font-black w-5 h-5 rounded-full flex items-center justify-center text-xs shadow-md">+</span>
                </div>
                <div>
                    <h2 class="text-xs font-bold text-white flex items-center space-x-1">
                        <span id="activeDeviceCount">1</span> Device Active 
                        <span class="text-slate-400 font-normal">(Max 2)</span>
                    </h2>
                    <span class="text-[10px] text-amber-400 font-mono">Composite ID: <strong id="displayCompositeId">105_8942</strong></span>
                </div>
            </div>

            <div class="flex items-center space-x-2">
                <div class="text-right">
                    <span class="text-[10px] text-slate-400 block font-medium">Balance (+Cashback)</span>
                    <span id="walletBalanceText" class="text-emerald-400 font-extrabold text-sm font-mono">৳ 2100.00</span>
                </div>
                <button onclick="openAddBalanceModal()" class="w-8 h-8 bg-emerald-600 hover:bg-emerald-500 text-slate-950 font-black rounded-xl flex items-center justify-center text-base shadow-md transition-all" title="Add Balance">
                    +
                </button>
            </div>
        </div>

        <!-- Top Profile Bar -->
        <div class="bg-[#131822] border border-slate-800/80 rounded-2xl p-3 flex items-center justify-between shadow-xl">
            <div class="flex items-center space-x-2.5">
                <div class="w-9 h-9 bg-emerald-500/10 border border-emerald-500/30 rounded-full flex items-center justify-center text-emerald-400 font-bold">
                    <i class="fa-solid fa-user-check text-sm"></i>
                </div>
                <div>
                    <h3 class="text-xs font-bold text-white flex items-center space-x-1">
                        <span>ID: <strong id="currentLoggedInUser" class="text-emerald-400">8942</strong></span>
                    </h3>
                    <div class="flex items-center space-x-1 mt-0.5">
                        <p class="text-[10px] text-amber-400 font-semibold">Validity: <span id="accountValidityDays">25</span> days</p>
                        <button type="button" onclick="openExtendValidityModal(event)" class="w-4 h-4 bg-amber-500/20 hover:bg-amber-500 text-amber-400 hover:text-slate-950 font-black rounded-full flex items-center justify-center text-[10px] transition-all" title="Extend Validity">
                            +
                        </button>
                    </div>
                </div>
            </div>

            <div class="flex items-center space-x-2">
                <button type="button" onclick="openSettingsModal(event)" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 font-bold py-1.5 px-2.5 rounded-xl text-xs flex items-center space-x-1 transition-all">
                    <i class="fa-solid fa-gear text-xs text-amber-400"></i>
                    <span>Settings</span>
                </button>
                <button type="button" onclick="handleLogOut()" class="bg-rose-600/20 hover:bg-rose-600/30 border border-rose-500/40 text-rose-400 font-bold py-1.5 px-2.5 rounded-xl text-xs flex items-center space-x-1 transition-all">
                    <i class="fa-solid fa-arrow-right-from-bracket text-xs"></i>
                    <span>Log Out</span>
                </button>
            </div>
        </div>

        <!-- Referral / Coupon Card -->
        <div class="bg-[#131822] border border-slate-800/80 rounded-2xl p-3.5 shadow-xl space-y-2.5">
            <div class="flex items-center justify-between text-xs">
                <span class="text-slate-300 font-bold flex items-center space-x-1.5">
                    <i class="fa-solid fa-link text-emerald-400"></i>
                    <span>Referral Chain & User Sale</span>
                </span>
                <span class="bg-indigo-900/40 text-indigo-300 border border-indigo-700/50 px-2 py-0.5 rounded-md text-[10px] font-semibold">
                    Sub-Users: <strong class="text-emerald-400 font-extrabold text-xs" id="subUserCount">5</strong> active
                </span>
            </div>
            
            <div class="flex items-center justify-between bg-[#080a0f] border border-slate-700/80 rounded-xl p-2.5">
                <div class="flex items-center space-x-2">
                    <span class="text-slate-400 text-xs">Coupon Code:</span>
                    <span id="userCouponCode" class="text-amber-400 font-extrabold tracking-widest text-sm bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/30">SIGMA-8942</span>
                </div>
                <button onclick="copyCouponCode()" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold py-1.5 px-3 rounded-lg flex items-center space-x-1 transition-all">
                    <i class="fa-regular fa-copy"></i>
                    <span>Copy</span>
                </button>
            </div>

            <div class="grid grid-cols-2 gap-2">
                <button onclick="openBuyLotModal()" class="bg-amber-600 hover:bg-amber-500 text-slate-950 font-bold py-2.5 px-2 rounded-xl text-xs flex items-center justify-center space-x-1 shadow-lg transition-all">
                    <i class="fa-solid fa-boxes-packing text-xs"></i>
                    <span>Buy New Lot</span>
                </button>
                <button onclick="openSellLicenseModal()" class="bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 text-white font-bold py-2.5 px-2 rounded-xl text-xs flex items-center justify-center space-x-1 shadow-lg transition-all">
                    <i class="fa-solid fa-paper-plane text-xs"></i>
                    <span>Sell New ID</span>
                </button>
            </div>
        </div>

        <!-- Navigation Tabs Bar -->
        <div class="bg-[#131822] border border-slate-800/80 rounded-2xl p-2 shadow-xl">
            <div class="grid grid-cols-3 gap-1 text-xs">
                <button class="bg-emerald-600 text-white font-bold py-2 rounded-xl text-center shadow-md">Dashboard</button>
                <button onclick="openMyChatModal()" class="bg-[#1a2130] hover:bg-slate-800 text-slate-300 font-medium py-2 rounded-xl text-center border border-slate-700/50">My Chat</button>
                <button onclick="openCashMemoModal()" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-2 rounded-xl text-center shadow-md flex items-center justify-center space-x-1">
                    <i class="fa-solid fa-receipt"></i>
                    <span>Cash Memo</span>
                </button>
            </div>
        </div>

        <!-- Monthly Financial Summary Card -->
        <div class="bg-[#131822] border border-slate-800/80 rounded-2xl p-4 shadow-xl space-y-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-chart-line text-emerald-400 text-base"></i>
                    <h3 class="text-xs sm:text-sm font-bold text-white">Monthly Summary (Income, Expense, Surplus)</h3>
                </div>
                <button onclick="openIncomeModal()" class="bg-emerald-600 hover:bg-emerald-500 text-slate-950 font-bold px-3 py-1.5 rounded-xl text-xs flex items-center space-x-1 shadow transition-all shrink-0">
                    <span>+</span>
                    <span>New Income</span>
                </button>
            </div>

            <div class="overflow-x-auto border border-slate-800/80 rounded-xl">
                <table class="w-full text-left text-xs">
                    <thead class="bg-[#080a0f] text-slate-400 border-b border-slate-800">
                        <tr>
                            <th class="py-2.5 px-3">Month</th>
                            <th class="py-2.5 px-2">Total Income (৳)</th>
                            <th class="py-2.5 px-2">Total Expense (৳)</th>
                            <th class="py-2.5 px-2 text-right">Net Surplus (৳)</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-800/60 font-medium">
                        <tr class="bg-emerald-950/20 text-emerald-400 font-bold">
                            <td class="py-3 px-3 flex items-center space-x-1.5 cursor-pointer" onclick="toggleYear('year2026', 'icon2026')">
                                <i id="icon2026" class="fa-solid fa-minus text-xs"></i>
                                <span>Total Sum (2026)</span>
                            </td>
                            <td id="totalIncome2026" class="py-3 px-2">৳ 55,508.00</td>
                            <td id="totalExpense2026" class="py-3 px-2 text-rose-400">৳ 23,308.00</td>
                            <td id="totalSurplus2026" class="py-3 px-2 text-right">৳ 32,200.00</td>
                        </tr>

                        <tbody id="year2026" class="divide-y divide-slate-800/40">
                            <tr>
                                <td class="py-2.5 px-3 text-slate-300">November 2026 (Running)</td>
                                <td id="runningMonthIncome" class="py-2.5 px-2 text-emerald-400">৳ 25,000.00</td>
                                <td id="runningMonthExpense" class="py-2.5 px-2 text-rose-400">৳ 5,500.00</td>
                                <td id="runningMonthSurplus" class="py-2.5 px-2 text-right text-emerald-400">৳ 19,500.00</td>
                            </tr>
                        </tbody>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Loan Management Card -->
        <div class="bg-[#131822] border border-slate-800/80 rounded-2xl p-4 shadow-xl space-y-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-hand-holding-dollar text-amber-400 text-base"></i>
                    <h3 class="text-xs sm:text-sm font-bold text-white">Loan & Credit Records</h3>
                </div>
                <button onclick="openLoanModal()" class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-3 py-1.5 rounded-xl text-xs flex items-center space-x-1 shadow transition-all shrink-0">
                    <span>+</span>
                    <span>New Entry</span>
                </button>
            </div>

            <!-- Loan Given List -->
            <div class="bg-[#080a0f] border border-slate-800 rounded-xl p-3 space-y-2">
                <div class="flex items-center justify-between text-xs border-b border-slate-800 pb-2">
                    <span class="text-amber-400 font-bold">Receivable (পাবো)</span>
                    <span id="loanGivenTotalText" class="text-emerald-400 font-extrabold">Total: ৳ 3,000</span>
                </div>
                <div id="loanGivenList" class="space-y-2"></div>
            </div>

            <!-- Loan Taken List -->
            <div class="bg-[#080a0f] border border-slate-800 rounded-xl p-3 space-y-2">
                <div class="flex items-center justify-between text-xs border-b border-slate-800 pb-2">
                    <span class="text-rose-400 font-bold">Payable (দেবো)</span>
                    <span id="loanTakenTotalText" class="text-rose-400 font-extrabold">Total: ৳ 4,000</span>
                </div>
                <div id="loanTakenList" class="space-y-2"></div>
            </div>
        </div>

        <!-- Daily Expenses Card -->
        <div class="bg-[#131822] border border-slate-800/80 rounded-2xl p-4 shadow-xl space-y-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-cart-shopping text-indigo-400 text-base"></i>
                    <h3 class="text-xs sm:text-sm font-bold text-white">Daily Expenses Log</h3>
                </div>
                <button onclick="openMarketModal()" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-3 py-1.5 rounded-xl text-xs flex items-center space-x-1 shadow transition-all shrink-0">
                    <span>+</span>
                    <span>New Expense Entry</span>
                </button>
            </div>

            <div class="overflow-x-auto border border-slate-800/80 rounded-xl">
                <table class="w-full text-left text-xs">
                    <thead class="bg-[#080a0f] text-slate-400 border-b border-slate-800">
                        <tr>
                            <th class="py-2.5 px-2">Date</th>
                            <th class="py-2.5 px-2">Description</th>
                            <th class="py-2.5 px-2">Amount (৳)</th>
                            <th class="py-2.5 px-2 text-right">Status</th>
                        </tr>
                    </thead>
                    <tbody id="marketExpenseList" class="divide-y divide-slate-800/50 font-medium"></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ================= ALL MODAL WINDOWS ================= -->
    <div id="buyLicenseLandingModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-[#131822] border border-slate-700 w-full max-w-sm rounded-3xl p-6 shadow-2xl relative space-y-4">
            <button onclick="closeBuyLicenseLandingModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
            <h3 class="text-lg font-bold text-white">Buy New ID / License</h3>
            <form onsubmit="handleLandingBuySubmit(event)" class="space-y-3">
                <input type="text" id="landingBuyMobile" placeholder="01XXXXXXXXX" required class="w-full bg-[#080a0f] border border-slate-700 rounded-xl py-2.5 px-3 text-slate-200 text-xs">
                <input type="email" id="landingBuyEmail" placeholder="email@domain.com" required class="w-full bg-[#080a0f] border border-slate-700 rounded-xl py-2.5 px-3 text-slate-200 text-xs">
                <button type="submit" class="w-full buy-btn-gradient text-slate-950 font-black py-3 rounded-xl text-xs">Complete Payment</button>
            </form>
        </div>
    </div>

    <div id="modLoginModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-[#131822] border border-slate-700 w-full max-w-sm rounded-3xl p-6 shadow-2xl relative space-y-4">
            <button onclick="closeModLoginModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
            <h3 class="text-lg font-bold text-white">Moderator Login</h3>
            <form onsubmit="handleModLogin(event)" class="space-y-3">
                <input type="text" id="modUserId" placeholder="4-Digit User ID" required class="w-full bg-[#080a0f] border border-slate-700 rounded-xl py-2.5 px-3 text-emerald-400 text-xs">
                <input type="password" id="modPassword" placeholder="Password" required class="w-full bg-[#080a0f] border border-slate-700 rounded-xl py-2.5 px-3 text-emerald-400 text-xs">
                <button type="submit" class="w-full bg-emerald-600 text-slate-950 font-bold py-3 rounded-xl text-xs">Login</button>
            </form>
        </div>
    </div>

    <div id="addDeviceModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-[#131822] border border-slate-700 w-full max-w-sm rounded-3xl p-6 shadow-2xl relative space-y-4">
            <button onclick="closeAddDeviceModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
            <h3 class="text-lg font-bold text-white">Add Device</h3>
            <form onsubmit="handleAddDeviceSubmit(event)" class="space-y-3">
                <input type="text" id="deviceNameInput" placeholder="Device Name" required class="w-full bg-[#080a0f] border border-slate-700 rounded-xl py-2.5 px-3 text-slate-200 text-xs">
                <label class="flex items-center space-x-2 bg-[#080a0f] p-3 rounded-xl border border-slate-700 text-xs cursor-pointer">
                    <input type="radio" name="devicePayMethod" value="Wallet" checked>
                    <span>Deduct ৳100 from Wallet</span>
                </label>
                <button type="submit" class="w-full bg-emerald-600 text-slate-950 font-bold py-3 rounded-xl text-xs">Pay & Add Device</button>
            </form>
        </div>
    </div>

    <div id="addBalanceModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-[#131822] border border-slate-700 w-full max-w-sm rounded-3xl p-6 shadow-2xl relative space-y-4">
            <button onclick="closeAddBalanceModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
            <h3 class="text-lg font-bold text-white">Recharge Wallet</h3>
            <form onsubmit="handleAddBalanceSubmit(event)" class="space-y-3">
                <input type="number" id="rechargeAmount" value="500" min="50" required class="w-full bg-[#080a0f] border border-slate-700 rounded-xl py-2.5 px-3 text-emerald-400 text-xs">
                <select id="paymentGatewaySelect" class="w-full bg-[#080a0f] border border-slate-700 rounded-xl py-2.5 px-3 text-slate-200 text-xs">
                    <option value="bKash">bKash</option>
                    <option value="Nagad">Nagad</option>
                </select>
                <button type="submit" class="w-full bg-emerald-600 text-slate-950 font-bold py-3 rounded-xl text-xs">Proceed</button>
            </form>
        </div>
    </div>

    <div id="incomeModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-[#131822] border border-slate-700 w-full max-w-sm rounded-3xl p-6 shadow-2xl relative space-y-4">
            <button onclick="closeIncomeModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
            <h3 class="text-lg font-bold text-white">Add Income</h3>
            <form onsubmit="handleIncomeSubmit(event)" class="space-y-3">
                <input type="date" id="incomeDate" required class="w-full bg-[#080a0f] border border-slate-700 rounded-xl py-2.5 px-3 text-slate-200 text-xs">
                <input type="text" id="incomeDesc" placeholder="Description" required class="w-full bg-[#080a0f] border border-slate-700 rounded-xl py-2.5 px-3 text-slate-200 text-xs">
                <input type="number" id="incomeAmount" placeholder="Amount (৳)" required class="w-full bg-[#080a0f] border border-slate-700 rounded-xl py-2.5 px-3 text-emerald-400 text-xs">
                <button type="submit" class="w-full bg-emerald-600 text-slate-950 font-bold py-3 rounded-xl text-xs">Save Income</button>
            </form>
        </div>
    </div>

    <div id="loanModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-[#131822] border border-slate-700 w-full max-w-sm rounded-3xl p-6 shadow-2xl relative space-y-4">
            <button onclick="closeLoanModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
            <h3 class="text-lg font-bold text-white">Add Loan Record</h3>
            <form onsubmit="handleLoanSubmit(event)" class="space-y-3">
                <select id="loanType" class="w-full bg-[#080a0f] border border-slate-700 rounded-xl py-2.5 px-3 text-slate-200 text-xs">
                    <option value="Receivable">Receivable (পাবো)</option>
                    <option value="Payable">Payable (দেবো)</option>
                </select>
                <input type="date" id="loanDate" required class="w-full bg-[#080a0f] border border-slate-700 rounded-xl py-2.5 px-3 text-slate-200 text-xs">
                <input type="text" id="loanPersonName" placeholder="Person Name" required class="w-full bg-[#080a0f] border border-slate-700 rounded-xl py-2.5 px-3 text-slate-200 text-xs">
                <input type="number" id="loanAmount" placeholder="Amount (৳)" required class="w-full bg-[#080a0f] border border-slate-700 rounded-xl py-2.5 px-3 text-amber-400 text-xs">
                <button type="submit" class="w-full bg-amber-500 text-slate-950 font-bold py-3 rounded-xl text-xs">Save Loan</button>
            </form>
        </div>
    </div>

    <div id="marketModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
        <div class="bg-[#131822] border border-slate-700 w-full max-w-sm rounded-3xl p-6 shadow-2xl relative space-y-4">
            <button onclick="closeMarketModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white"><i class="fa-solid fa-xmark text-lg"></i></button>
            <h3 class="text-lg font-bold text-white">Add Expense Record</h3>
            <form onsubmit="handleMarketSubmit(event)" class="space-y-3">
                <input type="date" id="marketDate" required class="w-full bg-[#080a0f] border border-slate-700 rounded-xl py-2.5 px-3 text-slate-200 text-xs">
                <input type="text" id="marketDesc" placeholder="Description" required class="w-full bg-[#080a0f] border border-slate-700 rounded-xl py-2.5 px-3 text-slate-200 text-xs">
                <input type="number" id="marketAmount" placeholder="Amount (৳)" required class="w-full bg-[#080a0f] border border-slate-700 rounded-xl py-2.5 px-3 text-rose-400 text-xs">
                <select id="marketStatus" class="w-full bg-[#080a0f] border border-slate-700 rounded-xl py-2.5 px-3 text-slate-200 text-xs">
                    <option value="Paid">Paid</option>
                    <option value="Due">Due (Payable)</option>
                </select>
                <button type="submit" class="w-full bg-indigo-600 text-white font-bold py-3 rounded-xl text-xs">Save Expense</button>
            </form>
        </div>
    </div>

    <!-- Script Section: Secure Backend Integration -->
    <script>
        function showToast(text) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-text').innerText = text;
            toast.classList.remove('hidden');
            setTimeout(() => { toast.classList.add('hidden'); }, 3500);
        }

        function hideToast() { document.getElementById('toast').classList.add('hidden'); }
        function formatMoney(amount) { return '৳ ' + Number(amount).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }

        // ==========================================
        // BACKEND API SYNC & FETCH
        // ==========================================
        async function fetchDashboardData() {
            try {
                const response = await fetch(`/api/dashboard/data?company_id=${GLOBAL_COMPANY_ID}&composite_user_id=${currentCompositeUserId}`, {
                    method: 'GET',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include'
                });
                const result = await response.json();
                if (result.success) {
                    currentWalletBalance = result.data.user.wallet_balance;
                    currentValidityDays = result.data.user.validity_days;
                    activeDevices = result.data.devices.length;
                    updateFinancialDisplays();
                }
            } catch (error) {
                console.error("Sync Error:", error);
            }
        }

        function updateFinancialDisplays() {
            document.getElementById('walletBalanceText').innerText = formatMoney(currentWalletBalance);
            document.getElementById('accountValidityDays').innerText = currentValidityDays;
            document.getElementById('activeDeviceCount').innerText = activeDevices;
            document.getElementById('displayCompositeId').innerText = currentCompositeUserId;
        }

        // ==========================================
        // AUTHENTICATION & LOGIN (POST TO BACKEND)
        // ==========================================
        async function handleMainSignIn(event) {
            event.preventDefault();
            const inputVal = document.getElementById('mainUserId').value.trim();
            const password = document.getElementById('mainUserPassword').value;
            const companyId = document.getElementById('signInCompanyId').value;
            if(!inputVal) return;

            currentUserId = inputVal.length <= 4 ? inputVal.padStart(4, '0') : inputVal.slice(-4);
            currentCompositeUserId = `${companyId}_${currentUserId}`;

            const payload = {
                company_id: parseInt(companyId),
                user_id: currentUserId,
                composite_user_id: currentCompositeUserId,
                password: password
            };

            try {
                const response = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload),
                    credentials: 'include'
                });
                const result = await response.json();

                if (response.ok && result.success) {
                    document.getElementById('currentLoggedInUser').innerText = currentUserId;
                    document.getElementById('page1').classList.add('hidden');
                    document.getElementById('page2').classList.remove('hidden');
                    fetchDashboardData();
                    showToast(`Signed in successfully! Composite ID: ${currentCompositeUserId}`);
                } else {
                    showToast(result.message || 'Login failed!');
                }
            } catch (error) {
                showToast('Server connection error!');
            }
        }

        async function handleLogOut() {
            try { await fetch('/api/auth/logout', { method: 'POST', credentials: 'include' }); } catch(e) {}
            document.getElementById('page2').classList.add('hidden');
            document.getElementById('page1').classList.remove('hidden');
            showToast('Logged out successfully');
        }

        // ==========================================
        // SECURE FORM SUBMISSIONS
        // ==========================================
        async function handleIncomeSubmit(event) {
            event.preventDefault();
            const payload = {
                company_id: GLOBAL_COMPANY_ID,
                user_id: currentUserId,
                composite_user_id: currentCompositeUserId,
                date: document.getElementById('incomeDate').value,
                description: document.getElementById('incomeDesc').value,
                amount: parseFloat(document.getElementById('incomeAmount').value) || 0
            };
            const res = await sendDataToBackend('/api/income/store', payload);
            if(res.success) {
                runningIncome += payload.amount;
                totalIncome2026 += payload.amount;
                updateFinancialDisplays();
                closeIncomeModal();
                showToast('Income record saved!');
            }
        }

        async function handleMarketSubmit(event) {
            event.preventDefault();
            const payload = {
                company_id: GLOBAL_COMPANY_ID,
                user_id: currentUserId,
                composite_user_id: currentCompositeUserId,
                date: document.getElementById('marketDate').value,
                description: document.getElementById('marketDesc').value,
                amount: parseFloat(document.getElementById('marketAmount').value) || 0,
                payment_status: document.getElementById('marketStatus').value
            };
            const res = await sendDataToBackend('/api/expenses/store', payload);
            if(res.success) {
                runningExpense += payload.amount;
                totalExpense2026 += payload.amount;
                updateFinancialDisplays();
                closeMarketModal();
                showToast('Expense record saved!');
            }
        }

        async function handleLoanSubmit(event) {
            event.preventDefault();
            const payload = {
                company_id: GLOBAL_COMPANY_ID,
                user_id: currentUserId,
                composite_user_id: currentCompositeUserId,
                category: document.getElementById('loanType').value,
                date: document.getElementById('loanDate').value,
                person_name: document.getElementById('loanPersonName').value,
                amount: parseFloat(document.getElementById('loanAmount').value) || 0,
                status: 'Pending'
            };
            const res = await sendDataToBackend('/api/loans/store', payload);
            if(res.success) {
                closeLoanModal();
                showToast('Loan record saved!');
            }
        }

        async function handleAddDeviceSubmit(event) {
            event.preventDefault();
            const payload = {
                company_id: GLOBAL_COMPANY_ID,
                user_id: currentUserId,
                composite_user_id: currentCompositeUserId,
                device_name: document.getElementById('deviceNameInput').value,
                payment_method: 'Wallet',
                charge_amount: 100.00
            };
            const res = await sendDataToBackend('/api/devices/store', payload);
            if(res.success) {
                activeDevices += 1;
                updateFinancialDisplays();
                closeAddDeviceModal();
                showToast('Device added successfully!');
            }
        }

        async function sendDataToBackend(url, data) {
            try {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data),
                    credentials: 'include'
                });
                const result = await response.json();
                if (!response.ok) {
                    showToast(result.message || 'Operation failed!');
                    return { success: false };
                }
                return { success: true, data: result };
            } catch (error) {
                showToast('Network error!');
                return { success: false };
            }
        }

        // Modals Control
        function openBuyLicenseLandingModal() { document.getElementById('buyLicenseLandingModal').classList.remove('hidden'); }
        function closeBuyLicenseLandingModal() { document.getElementById('buyLicenseLandingModal').classList.add('hidden'); }
        function handleLandingBuySubmit(event) { event.preventDefault(); closeBuyLicenseLandingModal(); showToast('License request submitted.'); }

        function openModLoginModal() { document.getElementById('modLoginModal').classList.remove('hidden'); }
        function closeModLoginModal() { document.getElementById('modLoginModal').classList.add('hidden'); }
        function handleModLogin(event) { event.preventDefault(); closeModLoginModal(); showToast('Moderator mode activated.'); }

        function openAddDeviceModal() { document.getElementById('addDeviceModal').classList.remove('hidden'); }
        function closeAddDeviceModal() { document.getElementById('addDeviceModal').classList.add('hidden'); }

        function openAddBalanceModal() { document.getElementById('addBalanceModal').classList.remove('hidden'); }
        function closeAddBalanceModal() { document.getElementById('addBalanceModal').classList.add('hidden'); }
        function handleAddBalanceSubmit(event) {
            event.preventDefault();
            const amt = parseFloat(document.getElementById('rechargeAmount').value) || 0;
            currentWalletBalance += amt;
            updateFinancialDisplays();
            closeAddBalanceModal();
            showToast(`Recharge of ৳${amt} successful!`);
        }

        function openIncomeModal() { document.getElementById('incomeModal').classList.remove('hidden'); }
        function closeIncomeModal() { document.getElementById('incomeModal').classList.add('hidden'); }

        function openLoanModal() { document.getElementById('loanModal').classList.remove('hidden'); }
        function closeLoanModal() { document.getElementById('loanModal').classList.add('hidden'); }

        function openMarketModal() { document.getElementById('marketModal').classList.remove('hidden'); }
        function closeMarketModal() { document.getElementById('marketModal').classList.add('hidden'); }

        function openMyChatModal() {}
        function openCashMemoModal() {}
        function copyCouponCode() { showToast('Coupon copied!'); }
        function toggleYear() {}
        function handleSendMessage(event) { event.preventDefault(); document.getElementById('chatInput').value = ''; }

        window.addEventListener('DOMContentLoaded', () => {
            const today = new Date().toISOString().split('T')[0];
            if(document.getElementById('marketDate')) document.getElementById('marketDate').value = today;
            if(document.getElementById('incomeDate')) document.getElementById('incomeDate').value = today;
            updateFinancialDisplays();
        });
    </script>
</body>
</html>
