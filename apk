        function openRepayModal(type, personName, amount) {
            window.currentRepayBtn = event.currentTarget;
            document.getElementById('repayType').value = type;
            document.getElementById('repayBaseAmount').value = amount;
            document.getElementById('repayPersonLabel').innerText = `Entity: ${personName} (৳${amount})`;
            document.getElementById('repayDate').valueAsDate = new Date();
            document.getElementById('repayModal').classList.remove('hidden');
        }

        function closeRepayModal() { document.getElementById('repayModal').classList.add('hidden'); }

        function handleRepaySubmit(event) {
            event.preventDefault();
            const companyId = document.getElementById('repayCompanyId').value;
            const type = document.getElementById('repayType').value;
            const extraCharge = parseFloat(document.getElementById('repayExtraCharge').value) || 0;
            const dateStr = document.getElementById('repayDate').value;
            const formattedDate = dateStr ? dateStr.split('-').reverse().join('/') : '07/11/2026';

            if(type === 'given') {
                if(extraCharge > 0) {
                    runningIncome += extraCharge;
                    totalIncome2026 += extraCharge;
                }
            } else {
                if(extraCharge > 0) {
                    runningExpense += extraCharge;
                    totalExpense2026 += extraCharge;
                }
            }

            const targetBtn = window.currentRepayBtn;
            if(targetBtn) {
                const parentDiv = targetBtn.parentElement;
                parentDiv.innerHTML = `
                    <div class="text-right">
                        <span class="bg-emerald-950/80 text-emerald-400 border border-emerald-800/60 px-2 py-0.5 rounded-md text-[10px] font-bold block">Settled (পরিশোধিত)</span>
                        <span class="text-[9px] text-slate-500 font-mono block mt-0.5">${formattedDate}</span>
                    </div>
                `;
            }

            updateFinancialDisplays();
            closeRepayModal();
            showToast(`Loan settled (Co ID: ${companyId})!`);
        }

        // Market Modal
        function openMarketModal() { document.getElementById('marketModal').classList.remove('hidden'); }
        function closeMarketModal() { document.getElementById('marketModal').classList.add('hidden'); }

        function handleMarketSubmit(event) {
            event.preventDefault();
            const companyId = document.getElementById('expenseCompanyId').value;
            const dateStr = document.getElementById('marketDate').value;
            const desc = document.getElementById('marketDesc').value;
            const amount = parseFloat(document.getElementById('marketAmount').value) || 0;
            const status = document.getElementById('marketStatus').value;

            runningExpense += amount;
            totalExpense2026 += amount;

            const formattedDate = dateStr ? dateStr.split('-').reverse().join('/') : '07/11/2026';

            const container = document.getElementById('marketExpenseList');
            const statusBadge = status === 'paid' 
                ? `<span class="bg-emerald-950/80 text-emerald-400 border border-emerald-800/60 px-2 py-0.5 rounded-md text-[10px] font-bold">Paid</span>`
                : `<span class="bg-amber-950/80 text-amber-400 border border-amber-800/60 px-2 py-0.5 rounded-md text-[10px] font-bold">Due (Payable)</span>`;

            container.innerHTML = `
                <tr class="hover:bg-slate-900/50">
                    <td class="py-2.5 px-2 text-slate-400 font-mono">${formattedDate}</td>
                    <td class="py-2.5 px-2 text-slate-200 font-medium">${desc}</td>
                    <td class="py-2.5 px-2 text-rose-400 font-bold">৳ ${amount.toFixed(2)}</td>
                    <td class="py-2.5 px-2 text-right">${statusBadge}</td>
                </tr>
            ` + container.innerHTML;

            if(status === 'due') {
                loanTakenTotal += amount;
                const loanContainer = document.getElementById('loanTakenList');
                loanContainer.innerHTML += `
                    <div class="flex items-center justify-between bg-[#111622] p-2.5 rounded-xl border border-slate-800 text-xs">
                        <div class="flex items-center space-x-2">
                            <span class="text-slate-500 font-mono text-[11px]">${formattedDate.slice(0, 5)}</span>
                            <span class="font-bold text-slate-200">${desc}</span>
                        </div>
                        <div class="flex items-center space-x-2">
                            <span class="text-rose-400 font-bold">৳ ${amount}</span>
                            <button onclick="openRepayModal('taken', '${desc}', ${amount})" class="bg-rose-600/30 hover:bg-rose-600/50 text-rose-300 border border-rose-500/40 px-2 py-1 rounded-md text-[10px] font-bold transition-all">
                                Mark Settled
                            </button>
                        </div>
                    </div>
                `;
            }

            updateFinancialDisplays();
            closeMarketModal();
            showToast(`New expense entry added (Co ID: ${companyId})!`);
        }

