    <!-- Script Section for Logic -->
    <script>
        let activePrivateUser = null;

        function showToast(text) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-text').innerText = text;
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3500);
        }

        function hideToast() {
            document.getElementById('toast').classList.add('hidden');
        }

        function formatMoney(amount) {
            return '৳ ' + Number(amount).toLocaleString('bn-BD', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function updateFinancialDisplays() {
            document.getElementById('walletBalanceText').innerText = formatMoney(currentWalletBalance);
            document.getElementById('modalWalletBalance').innerText = formatMoney(currentWalletBalance);

            document.getElementById('accountValidityDays').innerText = currentValidityDays;
            document.getElementById('currentValidityInModal').innerText = currentValidityDays + ' দিন';

            document.getElementById('activeDeviceCount').innerText = activeDevices;
            document.getElementById('subUserCount').innerText = totalSubUsers;

            document.getElementById('runningMonthIncome').innerText = formatMoney(runningIncome);
            document.getElementById('runningMonthExpense').innerText = formatMoney(runningExpense);
            document.getElementById('runningMonthSurplus').innerText = formatMoney(runningIncome - runningExpense);

            document.getElementById('totalIncome2026').innerText = formatMoney(totalIncome2026);
            document.getElementById('totalExpense2026').innerText = formatMoney(totalExpense2026);
            document.getElementById('totalSurplus2026').innerText = formatMoney(totalIncome2026 - totalExpense2026);

            document.getElementById('loanGivenTotalText').innerText = 'মোট: ' + formatMoney(loanGivenTotal);
            document.getElementById('loanTakenTotalText').innerText = 'মোট: ' + formatMoney(loanTakenTotal);
        }

        // Page Navigation
        function handleMainSignIn(event) {
            event.preventDefault();
            const userId = document.getElementById('mainUserId').value;
            if(!userId) return;
            document.getElementById('currentLoggedInUser').innerText = userId;
            document.getElementById('page1').classList.add('hidden');
            document.getElementById('page2').classList.remove('hidden');
            showToast('সফলভাবে ড্যাশবোর্ডে সাইন ইন হয়েছে!');
        }

        function handleLogOut() {
            document.getElementById('page2').classList.add('hidden');
            document.getElementById('page1').classList.remove('hidden');
            showToast('লগআউট সম্পন্ন হয়েছে');
        }

        // Landing Page License Modal
        function openBuyLicenseLandingModal() {
            document.getElementById('buyLicenseLandingModal').classList.remove('hidden');
        }
        function closeBuyLicenseLandingModal() {
            document.getElementById('buyLicenseLandingModal').classList.add('hidden');
        }
        function handleLandingBuySubmit(event) {
            event.preventDefault();
            const mobile = document.getElementById('landingBuyMobile').value;
            let coupon = document.getElementById('landingBuyCoupon').value.trim();
            const gateway = document.getElementById('landingPayGateway').value;
            if(!coupon) coupon = 'ADMIN-DEFAULT';

            closeBuyLicenseLandingModal();
            showToast(`পেমেন্ট সফল! আইডি ও পাসওয়ার্ড ${mobile} এ মোবাইল ব্যাংকিং (${gateway}) মাধ্যমে পাঠানো হয়েছে।`);
        }

        // Chatbot logic
        function openModLoginModal() {
            document.getElementById('modLoginModal').classList.remove('hidden');
        }
        function closeModLoginModal() {
            document.getElementById('modLoginModal').classList.add('hidden');
        }
        function handleModLogin(event) {
            event.preventDefault();
            const modId = document.getElementById('modUserId').value;
            isModeratorLoggedIn = true;
            document.getElementById('modeBadge').innerText = 'Moderator Mode';
            document.getElementById('modeBadge').className = 'bg-amber-950/80 text-amber-400 border border-amber-800/60 px-2.5 py-1 rounded-full text-[11px] font-semibold';
            closeModLoginModal();
            showToast(`Moderator Mode Activated: ${modId}`);

            const chatBox = document.getElementById('chatBox');
            chatBox.innerHTML += `
                <div class="bg-amber-950/30 border border-amber-800/50 rounded-xl p-2.5 text-xs text-amber-300">
                    🛡️ System: User <strong>${modId}</strong> signed in as Moderator!
                </div>
            `;
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        function handleSendMessage(event) {
            event.preventDefault();
            const input = document.getElementById('chatInput');
            const msg = input.value.trim();
            if(!msg) return;

            const chatBox = document.getElementById('chatBox');
            if(isModeratorLoggedIn) {
                chatBox.innerHTML += `
                    <div class="bg-emerald-950/40 border border-emerald-800/50 rounded-xl p-2.5 text-xs text-emerald-200 self-end max-w-[85%]">
                        <div class="font-bold text-[10px] text-emerald-400 mb-0.5">🛡️ Moderator</div>
                        ${msg}
                    </div>
                `;
            } else {
                chatBox.innerHTML += `
                    <div class="bg-slate-800 border border-slate-700 rounded-xl p-2.5 text-xs text-slate-200 self-end max-w-[85%]">
                        <div class="font-bold text-[10px] text-slate-400 mb-0.5">Visitor</div>
                        ${msg}
                    </div>
                `;
            }
            input.value = '';
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        // Copy Coupon
        function copyCouponCode() {
            const coupon = document.getElementById('userCouponCode').innerText;
            const temp = document.createElement('textarea');
            temp.value = coupon;
            document.body.appendChild(temp);
            temp.select();
            document.execCommand('copy');
            document.body.removeChild(temp);
            showToast('কুপন কোড কপি করা হয়েছে!');
        }

        // Collapsible Year
        function toggleYear(yearId, iconId) {
            const yearElem = document.getElementById(yearId);
            const iconElem = document.getElementById(iconId);
            if(yearElem.classList.contains('hidden')) {
                yearElem.classList.remove('hidden');
                iconElem.className = 'fa-solid fa-minus text-xs';
            } else {
                yearElem.classList.add('hidden');
                iconElem.className = 'fa-solid fa-plus text-xs';
            }
        }

        // Settings Modal
        function openSettingsModal(event) { 
            if(event) event.stopPropagation();
            document.getElementById('settingsModal').classList.remove('hidden'); 
        }
        function closeSettingsModal() { document.getElementById('settingsModal').classList.add('hidden'); }

        function handleSettingsUpdate(event) {
            event.preventDefault();
            const newPass = document.getElementById('settingsNewPass').value;
            const confirmPass = document.getElementById('settingsConfirmPass').value;
            if(newPass !== confirmPass) {
                showToast('নতুন পাসওয়ার্ড দুটি মিলছে না!');
                return;
            }
            closeSettingsModal();
            showToast('প্রোফাইল ইমেইল ও পাসওয়ার্ড আপডেট সফল হয়েছে!');
        }

        // Add Device Modal
        function openAddDeviceModal() { document.getElementById('addDeviceModal').classList.remove('hidden'); }
        function closeAddDeviceModal() { document.getElementById('addDeviceModal').classList.add('hidden'); }

        function handleAddDeviceSubmit(event) {
            event.preventDefault();
            const payMethod = document.querySelector('input[name="devicePayMethod"]:checked').value;
            if(payMethod === 'wallet') {
                if(currentWalletBalance < 100) {
                    showToast('অপর্যাপ্ত ওয়ালেট ব্যালেন্স!');
                    return;
                }
                currentWalletBalance -= 100;
            }
            activeDevices += 1;
            updateFinancialDisplays();
            closeAddDeviceModal();
            showToast('নতুন ডিভাইস সফলভাবে যুক্ত করা হয়েছে!');
        }

        // Recharge Modal
        function openAddBalanceModal() { document.getElementById('addBalanceModal').classList.remove('hidden'); }
        function closeAddBalanceModal() { document.getElementById('addBalanceModal').classList.add('hidden'); }

        function handleAddBalanceSubmit(event) {
            event.preventDefault();
            const amount = parseFloat(document.getElementById('rechargeAmount').value) || 0;
            const gateway = document.getElementById('paymentGatewaySelect').value;
            currentWalletBalance += amount;
            updateFinancialDisplays();
            closeAddBalanceModal();
            showToast(`${gateway}-এর মাধ্যমে ৳${amount} রিচার্জ সফল হয়েছে!`);
        }

        // Extend Validity Modal
        function openExtendValidityModal(event) { 
            if(event) event.stopPropagation();
            document.getElementById('extendValidityModal').classList.remove('hidden'); 
        }
        function closeExtendValidityModal() { document.getElementById('extendValidityModal').classList.add('hidden'); }

        function toggleExtendInput(val) {
            const group = document.getElementById('extendCouponGroup');
            if(val === 'coupon') {
                group.classList.remove('hidden');
            } else {
                group.classList.add('hidden');
            }
        }

        function handleExtendValiditySubmit(event) {
            event.preventDefault();
            const method = document.getElementById('extendMethod').value;
            if(method === 'gateway') {
                if(currentWalletBalance < 100) {
                    showToast('অপর্যাপ্ত ওয়ালেট ব্যালেন্স! রিচার্জ করুন।');
                    return;
                }
                currentWalletBalance -= 100;
            }
            currentValidityDays += 30;
            updateFinancialDisplays();
            closeExtendValidityModal();
            showToast('মেয়াদ সফলভাবে আরও ৩০ দিন বাড়ানো হয়েছে!');
        }

        // Buy Lot Modal
        function openBuyLotModal() { document.getElementById('buyLotModal').classList.remove('hidden'); }
        function closeBuyLotModal() { document.getElementById('buyLotModal').classList.add('hidden'); }

        function calculateLotPrice(val) {
            let price = '৳ ২০০০.০০';
            if(val === '50') price = '৳ ৪৫০০.০০';
            if(val === '100') price = '৳ ৮০০০.০০';
            document.getElementById('lotTotalPrice').value = price;
        }

        function handleBuyLotSubmit(event) {
            event.preventDefault();
            const lot = document.getElementById('lotPackageSelect').value;
            const price = document.getElementById('lotTotalPrice').value;
            const gateway = document.getElementById('lotPaymentGateway').value;
            closeBuyLotModal();
            showToast(`সফলভাবে ${lot} টি আইডির লট (${price}) ${gateway}-এর মাধ্যমে ক্রয় সম্পন্ন হয়েছে!`);
        }

        // Sell ID Modal
        function openSellLicenseModal() { document.getElementById('sellLicenseModal').classList.remove('hidden'); }
        function closeSellLicenseModal() { document.getElementById('sellLicenseModal').classList.add('hidden'); }

        function handleSellLicenseSubmit(event) {
            event.preventDefault();
            const mobile = document.getElementById('buyUserMobile').value;
            let coupon = document.getElementById('buyUserCoupon').value.trim();
            const gateway = document.getElementById('buyPayGateway').value;
            
            if(!coupon) coupon = "ADMIN-DEFAULT";

            totalSubUsers += 1;
            updateFinancialDisplays();
            closeSellLicenseModal();
            showToast(`আইডি তৈরি হয়েছে! কুপন: ${coupon} (${gateway})`);
        }

        // Income Modal
        function openIncomeModal() { document.getElementById('incomeModal').classList.remove('hidden'); }
        function closeIncomeModal() { document.getElementById('incomeModal').classList.add('hidden'); }

        function handleIncomeSubmit(event) {
            event.preventDefault();
            const amount = parseFloat(document.getElementById('incomeAmount').value) || 0;
            runningIncome += amount;
            totalIncome2026 += amount;
            updateFinancialDisplays();
            closeIncomeModal();
            showToast('নতুন আয় সফলভাবে যুক্ত হয়েছে!');
        }

        // Loan Modal
        function openLoanModal() { document.getElementById('loanModal').classList.remove('hidden'); }
        function closeLoanModal() { document.getElementById('loanModal').classList.add('hidden'); }

        function handleLoanSubmit(event) {
            event.preventDefault();
            const type = document.getElementById('loanType').value;
            const name = document.getElementById('loanPersonName').value;
            const amount = parseFloat(document.getElementById('loanAmount').value) || 0;
            const date = document.getElementById('loanDate').value;

            if(type === 'given') {
                loanGivenTotal += amount;
                const container = document.getElementById('loanGivenList');
                container.innerHTML += `
                    <div class="flex items-center justify-between bg-[#111622] p-2.5 rounded-xl border border-slate-800 text-xs">
