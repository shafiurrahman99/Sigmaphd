                        <div class="flex items-center space-x-2">
                            <span class="text-rose-400 font-bold">৳ ${amount}</span>
                            <button onclick="openRepayModal('taken', '${name}', ${amount})" class="bg-rose-600/30 hover:bg-rose-600/50 text-rose-300 border border-rose-500/40 px-2 py-1 rounded-md text-[10px] font-bold transition-all">
                                পরিশোধ করুন
                            </button>
                        </div>
                    </div>
                `;
