                        <div class="flex items-center space-x-2">
                            <span class="text-emerald-400 font-bold">৳ ${amount}</span>
                            <button onclick="openRepayModal('given', '${name}', ${amount})" class="bg-emerald-600/30 hover:bg-emerald-600/50 text-emerald-300 border border-emerald-500/40 px-2 py-1 rounded-md text-[10px] font-bold transition-all">
