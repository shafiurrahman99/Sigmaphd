            const dateStr = document.getElementById('repayDate').value;
            const formattedDate = dateStr ? dateStr.split('-').reverse().join('/') : '07/11/2026';

            if(type === 'given') {
                if(extraCharge > 0) {
                    runningIncome += extraCharge;
                    totalIncome2026 += extraCharge;
