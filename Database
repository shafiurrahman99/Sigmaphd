                    <div class="flex items-center justify-between bg-[#111622] p-2.5 rounded-xl border border-slate-800 text-xs">
                        <div class="flex items-center space-x-2">
                            <span class="text-slate-500 font-mono text-[11px]">${date}</span>
                            <span class="font-bold text-slate-200">${name}</span>
