// databasefacing.js - Supabase Queries, Ledgers, Vault & Payment Gateways

const SUPABASE_URL = 'https://your-supabase-url.supabase.co';
const SUPABASE_ANON_KEY = 'your-supabase-anon-key';
let supabaseClient = null;

try {
    if (window.supabase && SUPABASE_URL.includes('http')) {
        supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    }
} catch (e) {
    console.warn("Supabase init notice:", e);
}

let cachedCompanyId = 1;
let currentUserId = '01818589423';

// 1. Load Financial Summary & Balances
async function loadFinancialSummary() {
    try {
        if (!supabaseClient) return;
        const { data, error } = await supabaseClient
            .from('app_financial_ledgers')
            .select('*')
            .eq('company_id', cachedCompanyId)
            .maybeSingle();

        if (error) throw error;
        if (data) {
            const walletDisplay = document.getElementById('displayWalletTop');
            const cashDisplay = document.getElementById('displayCashBalance');
            const incDisplay = document.getElementById('displayNovIncome');
            const expDisplay = document.getElementById('displayNovExpense');

            if (walletDisplay) walletDisplay.innerText = Number(data.wallet_balance || 0).toFixed(2);
            if (cashDisplay) cashDisplay.innerText = Number(data.cash_balance || 0).toFixed(2);
            if (incDisplay) incDisplay.innerText = Number(data.nov_income || 0).toFixed(2);
            if (expDisplay) expDisplay.innerText = Number(data.nov_expense || 0).toFixed(2);
        }
    } catch (err) {
        console.error("Error fetching financial summary:", err.message);
    }
}

// 2. Load Recent Vault Transactions
async function loadTransactionsFromDB() {
    try {
        if (!supabaseClient) return;
        const { data, error } = await supabaseClient
            .from('app_transactions_vault')
            .select('*')
            .order('created_at', { ascending: false })
            .limit(15);

        if (error) throw error;
        const container = document.getElementById('vaultLogContainer');
        if (!container) return;

        if (!data || data.length === 0) {
            container.innerHTML = '<p class="text-slate-500">No transactions recorded yet.</p>';
            return;
        }

        container.innerHTML = data.map(item => {
            const isIncome = item.transaction_category === 'INCOME';
            const amount = item.payload && item.payload.amount ? item.payload.amount : 0;
            return `
                <div class="bg-slate-950 p-2.5 rounded-xl border border-slate-800 flex justify-between items-center text-xs">
                    <div>
                        <span class="${isIncome ? 'text-emerald-400' : 'text-rose-400'} font-mono font-bold">[${item.transaction_category || 'GENERAL'}]</span>
                        <span class="text-slate-200 ml-2">${item.record_key || 'N/A'}</span>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="font-mono font-bold ${isIncome ? 'text-emerald-400' : 'text-rose-400'}">৳${amount}</span>
                        <span class="text-slate-500 text-[10px]">Synced ✓</span>
                    </div>
                </div>
            `;
        }).join('');
    } catch (err) {
        console.error("Vault load error:", err.message);
    }
}

// 3. Handle Income Entry
async function handleIncomeSubmit(e) {
    if (e) e.preventDefault();
    const descInput = document.getElementById('incDescInput');
    const amtInput = document.getElementById('incAmountInput');
    const desc = descInput ? descInput.value.trim() : '';
    const amt = parseFloat(amtInput ? amtInput.value : 0) || 0;

    if (amt <= 0) return;

    try {
        if (supabaseClient) {
            await supabaseClient.from('app_transactions_vault').insert([{
                company_id: cachedCompanyId,
                user_id: currentUserId,
                transaction_category: 'INCOME',
                record_key: desc,
                payload: { amount: amt }
            }]);
        }
        if (descInput) descInput.value = '';
        if (amtInput) amtInput.value = '';
        closeModal('incomeEntryModal');
        loadTransactionsFromDB();
        loadFinancialSummary();
        showAlert(`Income entry of ৳${amt} successfully saved!`);
    } catch (err) {
        showAlert("Error saving income: " + err.message);
    }
}

