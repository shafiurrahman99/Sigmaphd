// --- 8. Loans & Investments Loader (Receivable / Payable) ---
async function loadInvestmentsFromDB() {
    try {
        if (!supabaseClient) return;
        const { data, error } = await supabaseClient
            .from('investments')
            .select('*')
            .order('created_at', { ascending: false });

        if (error) throw error;

        const givenContainer = document.getElementById('loanGivenList');
        const takenContainer = document.getElementById('loanTakenList');

        if (!data || data.length === 0) {
            if (givenContainer) givenContainer.innerHTML = '<p class="text-slate-500 text-xs">No receivable records.</p>';
            if (takenContainer) takenContainer.innerHTML = '<p class="text-slate-500 text-xs">No payable records.</p>';
            return;
        }

        const receivables = data.filter(i => i.loan_type === 'receivable');
        const payables = data.filter(i => i.loan_type === 'payable');

        if (givenContainer) {
            givenContainer.innerHTML = receivables.length === 0 ? '<p class="text-slate-500 text-xs">No receivables.</p>' :
            receivables.map(i => `
                <div class="bg-slate-900 p-2.5 rounded-xl border border-slate-800 flex justify-between items-center">
                    <div>
                        <span class="font-bold text-slate-200">${i.to_bank || i.description}</span>
                        <span class="text-[10px] text-slate-400 block">${i.settlement_status || 'due'}</span>
                    </div>
                    <span class="font-mono font-bold text-emerald-400">৳${i.amount}</span>
                </div>
            `).join('');
        }

        if (takenContainer) {
            takenContainer.innerHTML = payables.length === 0 ? '<p class="text-slate-500 text-xs">No payables.</p>' :
            payables.map(i => `
                <div class="bg-slate-900 p-2.5 rounded-xl border border-slate-800 flex justify-between items-center">
                    <div>
                        <span class="font-bold text-slate-200">${i.to_bank || i.description}</span>
                        <span class="text-[10px] text-slate-400 block">${i.settlement_status || 'due'}</span>
                    </div>
                    <span class="font-mono font-bold text-rose-400">৳${i.amount}</span>
                </div>
            `).join('');
        }
    } catch (err) {
        console.error("Investment load error:", err.message);
    }
}

async function handleLoanSubmit(e) {
    if (e) e.preventDefault();
    const personInput = document.getElementById('loanPersonInput');
    const amtInput = document.getElementById('loanAmountInput');
    const typeSelect = document.getElementById('loanTypeSelect');

    const person = personInput ? personInput.value.trim() : '';
    const amt = parseFloat(amtInput ? amtInput.value : 0) || 0;
    const loanType = typeSelect ? typeSelect.value : 'receivable';

    if (!person || amt <= 0) return;

    try {
        if (supabaseClient) {
            await supabaseClient.from('investments').insert([{
                company_id: cachedCompanyId,
                user_id: currentUserId,
                to_bank: person,
                amount: amt,
                description: `Loan record for ${person}`,
                loan_type: loanType,
                settlement_status: 'due'
            }]);
        }
        if (personInput) personInput.value = '';
        if (amtInput) amtInput.value = '';
        closeModal('loanEntryModal');
        loadInvestmentsFromDB();
        showAlert(`Loan entry (${loanType.toUpperCase()}) saved successfully!`);
    } catch (err) {
        showAlert("Error: " + err.message);
    }
}

// --- 9. Utility & Modal Helpers ---
function openIncomeEntryModal() { document.getElementById('incomeEntryModal').classList.remove('hidden'); }
function openLoanEntryModal() { document.getElementById('loanEntryModal').classList.remove('hidden'); }
function openMarketEntryModal() { document.getElementById('marketEntryModal').classList.remove('hidden'); }
function openBankSetupModal() { document.getElementById('bankSetupModal').classList.remove('hidden'); }
function openPaymentGatewayModal() { document.getElementById('paymentGatewayModal').classList.remove('hidden'); }
function openAccountSettingsModal() { document.getElementById('accountSettingsModal').classList.remove('hidden'); }
function openValidityPaymentOptionsModal() { document.getElementById('validityPaymentOptionsModal').classList.remove('hidden'); }
function openP2PTransferModal() { document.getElementById('p2pTransferModal').classList.remove('hidden'); }
function openAgentAuthModal() { document.getElementById('agentAuthModal').classList.remove('hidden'); }
function closeModal(id) { document.getElementById(id).classList.add('hidden'); }

function showAlert(msg) {
    const alertBox = document.getElementById('systemAlert');
    const alertMsg = document.getElementById('systemAlertMsg');
    if(alertBox && alertMsg) {
        alertMsg.innerText = msg;
        alertBox.classList.remove('hidden');
        setTimeout(() => { alertBox.classList.add('hidden'); }, 3000);
    } else {
        alert(msg);
    }
}
