// --- 1. Supabase Client Initialization (Safe Single Declaration) ---
const SUPABASE_URL = 'https://your-supabase-url.supabase.co'; // আপনার সঠিক Supabase URL এখানে দিন
const SUPABASE_ANON_KEY = 'your-supabase-anon-key'; // আপনার সঠিক Anon Key এখানে দিন

let supabaseClient = null;
try {
    if (window.supabase) {
        supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    }
} catch (e) {
    console.warn("Supabase init notice:", e);
}

let cachedCompanyId = 1;
let currentUserId = 'USR-1001';

// --- 2. Page Initialization on Load ---
document.addEventListener('DOMContentLoaded', () => {
    console.log("App Initialized successfully.");
    loadFinancialSummary();
    loadTransactionsFromDB();
    loadInvestmentsFromDB();
});

// --- 3. Sign In Handler (Fixes Page Transition) ---
async function handleSignIn(e) {
    if (e) e.preventDefault();
    const userIdInput = document.getElementById('inputUserId');
    const passwordInput = document.getElementById('inputPassword');

    const enteredId = userIdInput ? userIdInput.value.trim() : '';
    const enteredPass = passwordInput ? passwordInput.value.trim() : '';

    if (!enteredId || !enteredPass) {
        showAlert("Please enter both User ID and Password.");
        return;
    }

    try {
        console.log("Attempting sign in for ID:", enteredId);
        
        if (supabaseClient) {
            const { data, error } = await supabaseClient
                .from('companies')
                .select('*')
                .eq('company_id', enteredId)
                .maybeSingle();

            if (error) console.warn("Company table check notice:", error.message);
        }

        // Hide Login Page (Page 1) and Show Dashboard (Page 2)
        const page1 = document.getElementById('page1View');
        const page2 = document.getElementById('page2View');
        const topUser = document.getElementById('topSignInUser');

        if (page1) page1.classList.add('hidden');
        if (page2) page2.classList.remove('hidden');
        if (topUser) topUser.innerText = `User ID: ${enteredId}`;

        showAlert("Sign in successful!");
        
        // Load Live Database Data
        loadFinancialSummary();
        loadTransactionsFromDB();
        loadInvestmentsFromDB();
    } catch (err) {
        console.error("Sign-in Error:", err.message);
        showAlert("Sign in failed: " + err.message);
    }
}

function handleLogout() {
    const page1 = document.getElementById('page1View');
    const page2 = document.getElementById('page2View');
    if (page2) page2.classList.add('hidden');
    if (page1) page1.classList.remove('hidden');
    showAlert("Logged out successfully.");
}

// --- 4. Tab Switching Logic ---
function switchTab(tabName) {
    const tabs = ['dashboard', 'cashMemo', 'myChat', 'security'];
    tabs.forEach(t => {
        const el = document.getElementById(`tab${t.charAt(0).toUpperCase() + t.slice(1)}View`);
        const btn = document.getElementById(`tab${t === 'dashboard' ? 'Dash' : t.charAt(0).toUpperCase() + t.slice(1)}Btn`);
        if(el) el.classList.add('hidden');
        if(btn) btn.className = "px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs rounded-xl transition flex items-center gap-2 cursor-pointer";
    });

    let currentViewId = 'tabDashboardView';
    let currentBtnId = 'tabDashBtn';

    if (tabName === 'cashMemo') { currentViewId = 'tabCashMemoView'; currentBtnId = 'tabCashMemoBtn'; }
    else if (tabName === 'myChat') { currentViewId = 'tabMyChatView'; currentBtnId = 'tabMyChatBtn'; }
    else if (tabName === 'security') { currentViewId = 'tabSecurityView'; currentBtnId = 'tabSecBtn'; }

    const activeView = document.getElementById(currentViewId);
    const activeBtn = document.getElementById(currentBtnId);
    if(activeView) activeView.classList.remove('hidden');
    if(activeBtn) activeBtn.className = "px-5 py-2.5 bg-emerald-600 text-slate-950 font-bold text-xs rounded-xl transition flex items-center gap-2 cursor-pointer";
}

// --- 5. Financial Summary Loader ---
async function loadFinancialSummary() {
    try {
        if (!supabaseClient) return;
        const { data, error } = await supabaseClient
            .from('app_financial_ledgers')
            .select('*')
            .eq('company_id', cachedCompanyId)
            .maybeSingle();

        if (error) throw error;
        if (data) {
            const walletDisplay = document.getElementById('displayWalletTop');
            const cashDisplay = document.getElementById('displayCashBalance');
            const incDisplay = document.getElementById('displayNovIncome');
            const expDisplay = document.getElementById('displayNovExpense');

            if (walletDisplay) walletDisplay.innerText = Number(data.wallet_balance || 0).toFixed(2);
            if (cashDisplay) cashDisplay.innerText = Number(data.cash_balance || 0).toFixed(2);
            if (incDisplay) incDisplay.innerText = Number(data.nov_income || 0).toFixed(2);
            if (expDisplay) expDisplay.innerText = Number(data.nov_expense || 0).toFixed(2);
        }
    } catch (err) {
        console.error("Financial summary error:", err.message);
    }
}

// --- 6. Transactions Loader from Vault ---
async function loadTransactionsFromDB() {
    try {
        if (!supabaseClient) return;
        const { data, error } = await supabaseClient
            .from('app_transactions_vault')
            .select('*')
            .order('created_at', { ascending: false })
            .limit(20);

        if (error) throw error;
        const container = document.getElementById('marketLogTableBody');
        if (!container) return;

        if (!data || data.length === 0) {
            container.innerHTML = '<tr class="bg-slate-950"><td colspan="4" class="p-3 text-center text-slate-500">No transactions recorded.</td></tr>';
            return;
        }

        container.innerHTML = data.map(item => {
            const isIncome = item.transaction_category === 'INCOME';
            const amount = item.payload && item.payload.amount ? item.payload.amount : 0;
            return `
                <tr class="bg-slate-900/40 hover:bg-slate-900 transition">
                    <td class="p-3 font-sans ${isIncome ? 'text-emerald-400' : 'text-indigo-400'} font-bold">[${item.transaction_category}]</td>
                    <td class="p-3 font-sans text-slate-200">${item.record_key || 'N/A'}</td>
                    <td class="p-3 ${isIncome ? 'text-emerald-400' : 'text-rose-400'} font-bold font-mono">৳ ${amount}</td>
                    <td class="p-3 text-right text-emerald-400 font-sans">Synced ✓</td>
                </tr>
            `;
        }).join('');
    } catch (err) {
        console.error("Vault load error:", err.message);
    }
}

// --- 7. Income & Expense Handlers ---
async function handleIncomeSubmit(e) {
    if (e) e.preventDefault();
    const descInput = document.getElementById('incDescInput');
    const amtInput = document.getElementById('incAmountInput');
    const desc = descInput ? descInput.value.trim() : '';
    const amt = parseFloat(amtInput ? amtInput.value : 0) || 0;
    if (amt <= 0) return;

    try {
        if (supabaseClient) {
            await supabaseClient.from('app_transactions_vault').insert([{
                company_id: cachedCompanyId,
                user_id: currentUserId,
                transaction_category: 'INCOME',
                record_key: desc,
                payload: { amount: amt }
            }]);
        }
        if (descInput) descInput.value = '';
        if (amtInput) amtInput.value = '';
        closeModal('incomeEntryModal');
        loadTransactionsFromDB();
        loadFinancialSummary();
        showAlert(`Income of ৳${amt} saved successfully!`);
    } catch (err) {
        showAlert("Error: " + err.message);
    }
}

