// 5. Load Receivables & Payables (Loans)
async function loadInvestmentsFromDB() {
    try {
        if (!supabaseClient) return;
        const { data, error } = await supabaseClient
            .from('investments')
            .select('*')
            .order('created_at', { ascending: false });

        if (error) throw error;
        const container = document.getElementById('loanListContainer');
        if (!container) return;

        if (!data || data.length === 0) {
            container.innerHTML = '<p class="text-slate-500">No loan records found.</p>';
            return;
        }

        container.innerHTML = data.map(i => {
            const isReceivable = i.loan_type === 'receivable';
            return `
                <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 flex justify-between items-center text-xs">
                    <div>
                        <span class="px-2 py-0.5 rounded font-mono font-bold text-[10px] ${isReceivable ? 'bg-emerald-950 text-emerald-400' : 'bg-rose-950 text-rose-400'}">
                            ${isReceivable ? 'RECEIVABLE (পাবো)' : 'PAYABLE (দেবো)'}
                        </span>
                        <span class="font-bold text-slate-200 ml-2">${i.to_bank || i.description || 'N/A'}</span>
                        <span class="font-mono font-bold ml-3 text-amber-400">৳${i.amount}</span>
                    </div>
                    <span class="px-2 py-0.5 bg-slate-900 text-slate-400 rounded text-[10px] uppercase">${i.settlement_status || 'due'}</span>
                </div>
            `;
        }).join('');
    } catch (err) {
        console.error("Investment load error:", err.message);
    }
}

// 6. Handle Loan Entry
async function handleLoanSubmit(e) {
    if (e) e.preventDefault();
    const personInput = document.getElementById('loanPersonInput');
    const amtInput = document.getElementById('loanAmountInput');
    const typeSelect = document.getElementById('loanTypeSelect');

    const person = personInput ? personInput.value.trim() : '';
    const amt = parseFloat(amtInput ? amtInput.value : 0) || 0;
    const loanType = typeSelect ? typeSelect.value : 'receivable';

    if (!person || amt <= 0) return;

    try {
        if (supabaseClient) {
            await supabaseClient.from('investments').insert([{
                company_id: cachedCompanyId,
                user_id: currentUserId,
                from_bank: 'MAIN_VAULT',
                to_bank: person,
                amount: amt,
                description: `Loan entry for ${person}`,
                loan_type: loanType,
                settlement_status: 'due'
            }]);
        }
        if (personInput) personInput.value = '';
        if (amtInput) amtInput.value = '';
        closeModal('loanEntryModal');
        loadInvestmentsFromDB();
        showAlert(`Loan record (${loanType.toUpperCase()}) saved successfully!`);
    } catch (err) {
        showAlert("Error saving loan record: " + err.message);
    }
}

// 7. Initiate Payment Gateway Redirect
async function initiatePaymentGateway(e) {
    if (e) e.preventDefault();
    const amtInput = document.getElementById('payGatewayAmountInput');
    const gatewaySelect = document.getElementById('gatewayNameSelect');
    const amount = parseFloat(amtInput ? amtInput.value : 0) || 0;
    const gatewayName = gatewaySelect ? gatewaySelect.value : 'bKash';

    if (amount <= 0) {
        showAlert("Please enter a valid amount.");
        return;
    }

    try {
        const invoiceId = 'INV-' + Date.now();
        if (supabaseClient) {
            await supabaseClient.from('payments').insert([{
                company_id: cachedCompanyId,
                user_id: 1001,
                transaction_id: invoiceId,
                gateway_name: gatewayName,
                amount: amount,
                purpose: 'WALLET_RECHARGE',
                status: 'PENDING'
            }]);
        }
        showAlert(`Redirecting to secure ${gatewayName} Payment Gateway...`);
        setTimeout(() => {
            closeModal('paymentGatewayModal');
        }, 1500);
    } catch (err) {
        showAlert("Gateway initiation failed: " + err.message);
    }
}

// 8. Fetch Payment History
async function loadPaymentHistory() {
    try {
        if (!supabaseClient) return;
        const { data, error } = await supabaseClient
            .from('payments')
            .select('*')
            .order('created_at', { ascending: false });

        if (error) throw error;
        const container = document.getElementById('paymentHistoryContainer');
        if (!container) return;

        if (!data || data.length === 0) {
            container.innerHTML = '<p class="text-slate-500">No gateway payments recorded.</p>';
            return;
        }

        container.innerHTML = data.map(p => `
            <div class="bg-slate-950 p-3 rounded-xl border border-slate-800 flex justify-between items-center text-xs">
                <div>
                    <span class="font-bold text-emerald-400">${p.gateway_name || 'MFS'}</span>
                    <span class="text-slate-400 ml-2 font-mono">[${p.transaction_id}]</span>
                    <span class="font-mono font-bold ml-3 text-slate-200">৳${p.amount}</span>
                </div>
                <span class="px-2 py-0.5 rounded text-[10px] uppercase font-bold ${p.status === 'SUCCESS' ? 'bg-emerald-950 text-emerald-400' : 'bg-amber-950 text-amber-400'}">
                    ${p.status}
                </span>
            </div>
        `).join('');
    } catch (err) {
        console.error("Payment history error:", err.message);
    }
}
